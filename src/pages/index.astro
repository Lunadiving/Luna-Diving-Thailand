---
import OptimizedImage from '../components/OptimizedImage.astro';
import { resolveImage, originalImageUrl } from '../utils/images';
import Layout from '../layouts/Layout.astro';

// Hero: foto diversa su mobile (art direction), file originali senza ricompressione
const heroDesktop = resolveImage('/images/hero/hero-poster.webp');
const heroMobile = resolveImage('/images/hero/hero-poster-mobile.webp');
const heroDesktopUrl = originalImageUrl('/images/hero/hero-poster.webp');
const heroMobileUrl = originalImageUrl('/images/hero/hero-poster-mobile.webp');

const WHATSAPP_NUMBER = '66918233120';
const whatsappLink = (message: string) =>
  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;

const mainCategories = [
  {
    name: 'Liveaboard',
    seoTitle: 'Similan Liveaboards',
    description: '4 to 11-day dive trips to the Similan Islands, Richelieu Rock and the Mergui Archipelago, from THB 26,700.',
    image: '/images/hero/thailand-liveaboards.webp',
    link: '/thailand-liveaboards/',
    altText: 'Dive liveaboard cruising the Andaman Sea on the way to the Similan Islands, Thailand',
  },
  {
    name: 'Yacht',
    seoTitle: 'Yacht Charter Phuket',
    description: 'Eight private yachts, from sunset cruises to a 42m superyacht, for Phang Nga Bay, Krabi and Phi Phi.',
    image: '/images/hero/private-dive-boat-charters-phuket.webp',
    link: '/thailand-yachts/',
    altText: 'Private yacht charter anchored near a tropical island in Phuket',
  },
  {
    name: 'Courses',
    seoTitle: 'PADI Diving Courses',
    description: 'Learn to dive or level up in Phuket: Discover Scuba, Open Water, Advanced and Rescue Diver.',
    image: '/images/hero/padi-scuba-diving-courses.webp',
    link: '/padi-scuba-diving-courses/',
    altText: 'Scuba diving instructor teaching students open water skills in clear water',
  },
  {
    name: 'Day Trip',
    seoTitle: 'Diving Day Trips',
    description: 'Daily boat diving from Phuket to Phi Phi and the Racha Islands, plus Similan day trips from Khao Lak.',
    image: '/images/hero/day-trip-phuket.webp',
    link: '/day-trip-phuket/',
    altText: 'Dive boat taking scuba divers on a day trip from Phuket',
  },
  {
    name: 'Itinerary',
    seoTitle: 'Liveaboard Itineraries',
    description: 'Compare Similan and Surin, Southern Andaman and Best of the Andaman Sea routes before you book.',
    image: '/images/hero/liveaboard-itinerary-thailand.webp',
    link: '/liveaboard-itinerary-thailand/',
    altText: 'Map of liveaboard routes across the Andaman Sea islands of Thailand',
  },
  {
    name: 'Dive Sites',
    seoTitle: 'Andaman Sea Dive Sites',
    description: 'Similan Islands, Richelieu Rock, Hin Daeng, Burma Banks, Shark Point and the King Cruiser wreck.',
    image: '/images/hero/dive-sites.webp',
    link: '/dive-sites-thailand/',
    altText: 'Colourful coral reef and marine life at a Similan Islands dive site in Thailand',
  },
];

const highlights = [
  { value: '6', label: 'Dive liveaboards', note: 'From budget trips with free nitrox to historic sailing ships' },
  { value: '8', label: 'Private yachts', note: 'Sunset cruises, day charters and superyacht voyages' },
  { value: 'Oct–May', label: 'Similan season', note: 'The national park opens mid-October to mid-May' },
  { value: '1:4', label: 'Guide ratio', note: 'Small groups on our Similan liveaboards' },
];

const destinations = [
  {
    name: 'Similan Islands',
    text: 'Granite boulders, white sand beaches and clear blue water in a national park 70 km off Khao Lak, the heart of Thai liveaboard diving.',
    link: '/thailand-liveaboards/',
  },
  {
    name: 'Richelieu Rock',
    text: 'A horseshoe-shaped pinnacle near the Surin Islands, famous for whale sharks, seahorses and some of the best macro life in Thailand.',
    link: '/dive-sites-thailand/',
  },
  {
    name: 'Koh Bon & Koh Tachai',
    text: 'Exposed ridges and pinnacles north of the Similans, where strong currents bring manta rays and large schools of fish.',
    link: '/dive-sites-thailand/',
  },
  {
    name: 'Mergui Archipelago',
    text: 'Hundreds of remote islands in southern Myanmar, reached on longer liveaboards from Ranong, with reefs few divers ever see.',
    link: '/thailand-liveaboards/deep-andaman-queen/',
  },
  {
    name: 'Phang Nga Bay',
    text: 'Towering limestone karsts, hidden lagoons and calm water, best explored on a private yacht charter from Phuket.',
    link: '/thailand-yachts/',
  },
  {
    name: 'Phi Phi & Racha Islands',
    text: 'Easy reef diving and snorkelling within a short boat ride of Phuket, perfect for day trips and PADI training dives.',
    link: '/day-trip-phuket/',
  },
];

const faqs = [
  {
    q: 'When is the best time to dive the Similan Islands?',
    a: 'The Similan and Surin National Parks are open from mid-October to mid-May. The calmest seas and best visibility are usually from December to April, which is also when liveaboard departures book up first.'
  },
  {
    q: 'How much does a Similan Islands liveaboard cost?',
    a: 'A 5-day, 4-night Similan Islands liveaboard with 14 dives starts from THB 26,700 per person on MV Pawara, including free nitrox and hotel transfers. Prices depend on the boat, cabin and length of the trip, and marine park fees are paid on board.'
  },
  {
    q: 'Can beginners dive in Thailand?',
    a: 'Yes. Phuket is a popular place to learn to dive, with warm water all year. You can try diving with a PADI Discover Scuba Diving experience or get certified with the PADI Open Water Diver course, then join a day trip or liveaboard.'
  },
  {
    q: 'Do you offer private yacht charters in Phuket?',
    a: 'Yes. We offer eight private yachts in Phuket, from 3-hour sunset cruises from THB 41,000 to full-day charters to Phang Nga Bay, Krabi and Phi Phi, overnight trips and all-inclusive superyacht days for up to 20 guests.'
  },
  {
    q: 'Where are liveaboard departures from?',
    a: 'Most Similan liveaboards depart from Tab Lamu pier in Khao Lak, north of Phuket, with hotel transfers from Phuket and Khao Lak usually included. Some trips start from Chalong in Phuket, and Mergui Archipelago trips depart from Ranong.'
  },
  {
    q: 'How do I book with Luna Diving?',
    a: 'Contact us on WhatsApp at +66 91 823 3120, by email at info@luna-diving-thailand.com or through our contact form. Tell us your dates, group size and experience level, and we will check availability and recommend the best boat or course for you.'
  }
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TravelAgency',
    name: 'Luna Diving Thailand',
    url: 'https://luna-diving-thailand.com/',
    logo: 'https://luna-diving-thailand.com/logo.png',
    image: 'https://luna-diving-thailand.com/logo.png',
    telephone: '+66918233120',
    email: 'info@luna-diving-thailand.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '27/15 Soi Pattana, Moo 4',
      addressLocality: 'Rawai',
      addressRegion: 'Phuket',
      addressCountry: 'TH'
    },
    areaServed: ['Phuket', 'Khao Lak', 'Similan Islands', 'Andaman Sea'],
    description: 'Liveaboard dive trips to the Similan Islands and Richelieu Rock, private yacht charters, diving day trips and PADI courses in Phuket, Thailand.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a }
    }))
  }
];
---

<Layout
  title="Luna Diving Phuket | Similan Liveaboards, Yachts & PADI Courses"
  description="Similan Islands and Richelieu Rock liveaboards from THB 26,700, private yacht charters, diving day trips and PADI courses in Phuket and Khao Lak, Thailand."
  image="/images/hero/hero-poster.webp"
>
  <main class="main-wrapper" id="theme-wrapper">
    <section class="hero-container" aria-labelledby="hero-title">
      <!-- Tag Picture: Carica hero-poster-mobile.webp (800x1200) su smartphone -->
      <picture>
        <source
          media="(max-width: 768px)"
          srcset={heroMobileUrl}
          width={heroMobile.width}
          height={heroMobile.height}
        />
        <img
          src={heroDesktopUrl}
          alt="Luna Diving liveaboard safari boat navigating in Thailand"
          width={heroDesktop.width}
          height={heroDesktop.height}
          fetchpriority="high"
          class="hero-poster"
        />
      </picture>

      <div class="hero-overlay"></div>

      <div class="hero-content">
        <h1 id="hero-title" class="hero-title animated-element fade-in-second">
          Similan Liveaboards, Yacht Charters & Scuba Diving in Phuket
        </h1>

        <p class="hero-subtitle animated-element fade-in-third">
          Dive the Similan Islands and Richelieu Rock on a liveaboard, charter a private yacht
          to Phang Nga Bay, or learn to dive with a PADI course in Phuket.
        </p>

        <a
          href={whatsappLink("Hi Luna Diving! I'd like to check availability for a dive safari.")}
          target="_blank"
          rel="noopener noreferrer"
          class="hero-cta-button animated-element fade-in-fourth"
        >
          Check Availability
        </a>
        <a href="/thailand-liveaboards/" class="hero-secondary-link animated-element fade-in-fourth">
          Compare liveaboards
        </a>
      </div>
    </section>

    <section class="adventure-starts" aria-labelledby="intro-title">
      <h2 id="intro-title">Liveaboard Diving and Yacht Charters in Thailand</h2>

      <p class="seo-intro-text">
        Luna Diving is a Phuket-based diving and charter specialist on the Andaman Sea coast of Thailand.
        We book <a href="/thailand-liveaboards/">Similan Islands liveaboards</a> on six different boats,
        <a href="/thailand-yachts/">private yacht charters</a> on eight yachts, <a href="/day-trip-phuket/">diving day trips</a>
        and <a href="/padi-scuba-diving-courses/">PADI scuba diving courses</a>, all from one place.
      </p>

      <p class="seo-intro-text">
        Whether it is your first dive or your hundredth, we match you with the right trip: a budget-friendly
        5-day Similan liveaboard with free nitrox, an expedition to Richelieu Rock and the Mergui Archipelago,
        a sunset cruise on a classic wooden yacht, or a relaxed day of reef diving at Phi Phi and the Racha Islands.
      </p>
    </section>

    <section class="liveaboard-fleet" id="dark-fleet-section" aria-label="Explore Luna Diving experiences">
      <div class="card-grid">
        {
          mainCategories.map((category) => (
            <article class="liveaboard-card">
              <div class="card-image-wrapper">
                <OptimizedImage
                  src={category.image}
                  alt={category.altText}
                  class="card-image"
                  loading="lazy"
                  widths={[400, 800]}
                  sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
                />
                <div class="card-gradient"></div>
              </div>

              <div class="card-content">
                <span class="card-name-cursive">{category.name}</span>

                <div class="card-text-bottom">
                  <h3 class="card-name-bold">{category.seoTitle}</h3>

                  <p class="card-description">{category.description}</p>

                  <a
                    href={category.link}
                    class="card-cta"
                    aria-label={`View details: ${category.seoTitle}`}
                  >
                    <span>View Details</span>
                    <svg class="luna-arrow" viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M5 12h14M12 5l7 7-7 7"
                        stroke="currentColor"
                        stroke-width="2"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <section class="last-minute-banner" aria-labelledby="last-minute-title">
        <OptimizedImage
          src={'/images/hero/last-minute.webp'}
          alt="Liveaboard diving boat in Thailand"
          loading="lazy"
          class="banner-image"
          widths={[600, 1184]}
          sizes="(max-width: 1400px) 100vw, 1400px"
        />

        <div class="banner-overlay"></div>

        <div class="banner-content">
          <span class="banner-tag">Limited Availability</span>

          <h2 id="last-minute-title">Last Minute Deals & Liveaboard Offers</h2>

          <p>
            Grab exclusive empty-cabin discounts and last-second seasonal promotions
            for upcoming trips.
          </p>

          <a href="/last-minute/" class="banner-btn">Check Live Deals</a>
        </div>
      </section>
    </section>

    <section class="home-section" aria-labelledby="why-title">
      <h2 id="why-title" class="section-title">Why Book Your Thailand Dive Trip with Luna Diving</h2>
      <ul class="highlight-grid">
        {highlights.map((item) => (
          <li class="highlight-item">
            <span class="highlight-value">{item.value}</span>
            <span class="highlight-label">{item.label}</span>
            <span class="highlight-note">{item.note}</span>
          </li>
        ))}
      </ul>
      <p class="section-text">
        Because we work with a whole fleet instead of a single boat, we can recommend the trip that really suits you:
        the right dates, the right cabin, the right level of diving. Prices are clear, hotel transfers from Phuket and Khao Lak
        are included on most liveaboards, and you can reach us directly on WhatsApp before, during and after your trip.
      </p>
    </section>

    <section class="home-section" aria-labelledby="destinations-title">
      <h2 id="destinations-title" class="section-title">Best Diving Destinations in the Andaman Sea</h2>
      <div class="destination-grid">
        {destinations.map((place) => (
          <article class="destination-card">
            <h3 class="destination-name">{place.name}</h3>
            <p class="destination-text">{place.text}</p>
            <a href={place.link} class="destination-link" aria-label={`Explore ${place.name}`}>Explore →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="home-section" aria-labelledby="season-title">
      <h2 id="season-title" class="section-title">When to Dive in Thailand</h2>
      <div class="season-grid">
        <div class="season-card">
          <h3>October to May: Similan Season</h3>
          <p>
            The Similan and Surin National Parks open from mid-October to mid-May. This is liveaboard season, with calm seas,
            good visibility and the best chance of manta rays at Koh Bon and whale sharks at Richelieu Rock. December to April
            is the busiest period, so book early.
          </p>
        </div>
        <div class="season-card">
          <h3>All Year: Phuket Day Trips and Courses</h3>
          <p>
            Diving around Phuket continues all year, with day trips to Phi Phi, the Racha Islands and Shark Point, and PADI courses
            in warm water. Private yacht charters to Phang Nga Bay and Krabi also run year round.
          </p>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="faq-title">
      <h2 id="faq-title" class="section-title">Diving in Thailand: Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">{item.q}</summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <a
      href={whatsappLink("Hi Luna Diving! I'm planning a diving trip to Thailand and would like more information.")}
      target="_blank"
      rel="noopener noreferrer"
      class="luna-whatsapp-floating"
      aria-label="Chat with Luna Diving on WhatsApp"
    >
      <svg class="whatsapp-icon-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </main>
</Layout>

<style>
.main-wrapper {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  background-color: #ffffff;
  color: #000000;
  font-family: 'Inter', sans-serif;
}

.hero-container {
  position: relative;
  display: flex;
  min-height: 100svh;
  width: 100%;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-align: center;
  background: #111111;
}

.hero-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  z-index: 0;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: rgba(0, 0, 0, 0.35);
}

.hero-content {
  position: relative;
  z-index: 3;
  max-width: 1000px;
  padding: 0 1.5rem;
}

.hero-title {
  margin: 0 0 1.5rem;
  color: #ffffff;
  font-size: clamp(2rem, 5vw, 3.8rem);
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 2px;
  text-transform: uppercase;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
}

.hero-subtitle {
  max-width: 800px;
  margin: 0 auto 3.5rem;
  color: #f3f3f3;
  font-size: clamp(0.95rem, 2vw, 1.25rem);
  line-height: 1.6;
  letter-spacing: 1px;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
}

.hero-cta-button {
  display: inline-block;
  border: 1px solid #ffffff;
  background: #ffffff;
  padding: 1.2rem 3rem;
  color: #000000;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-decoration: none;
  text-transform: uppercase;
  transition: 0.25s ease;
}

.hero-cta-button:hover,
.hero-cta-button:focus-visible {
  background: transparent;
  color: #ffffff;
}

.hero-cta-button:focus-visible,
.card-cta:focus-visible,
.banner-btn:focus-visible,
.luna-whatsapp-floating:focus-visible {
  outline: 2px solid #ffffff;
  outline-offset: 4px;
}

.adventure-starts {
  max-width: 950px;
  margin: 0 auto;
  padding: 7rem 2rem 4rem;
  text-align: center;
}

.adventure-starts h2 {
  margin: 0 0 1.5rem;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 500;
}

.seo-intro-text {
  margin: 0 auto 1rem;
  color: #555555;
  line-height: 1.75;
}

.liveaboard-fleet {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 4rem 8rem;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-bottom: 2rem;
  content-visibility: auto;
  contain-intrinsic-size: auto 900px;
}

.liveaboard-card {
  position: relative;
  display: flex;
  aspect-ratio: 1.1 / 1;
  flex-direction: column;
  overflow: hidden;
  border-radius: 20px;
  background: #121212;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}

.card-image-wrapper {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
}

.liveaboard-card:hover .card-image {
  transform: scale(1.04);
}

.card-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0) 40%,
    rgba(0, 0, 0, 0.85) 90%
  );
}

.card-content {
  position: relative;
  z-index: 2;
  display: flex;
  height: 100%;
  flex-direction: column;
  justify-content: space-between;
  padding: 2.2rem;
  color: #ffffff;
}

.card-name-cursive {
  color: rgba(255, 255, 255, 0.85);
  font-family: 'Playfair Display', serif;
  font-size: 1.8rem;
  font-style: italic;
}

.card-name-bold {
  margin: 0 0 0.4rem;
  font-size: 1.4rem;
}

.card-description {
  margin: 0 0 1.5rem;
  color: #dddddd;
  font-size: 0.9rem;
  line-height: 1.5;
}

.card-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: #ffffff;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
}

.luna-arrow {
  width: 16px;
  height: 16px;
  transition: transform 0.3s ease;
}

.card-cta:hover .luna-arrow,
.card-cta:focus-visible .luna-arrow {
  transform: translateX(5px);
}

.last-minute-banner {
  position: relative;
  display: flex;
  min-height: 360px;
  align-items: center;
  overflow: hidden;
  border: 1px solid #1c1c1e;
  border-radius: 20px;
  background: #0c0c0e;
  padding: 4rem;
  content-visibility: auto;
  contain-intrinsic-size: auto 500px;
}

.banner-image,
.banner-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.banner-image {
  object-fit: cover;
}

.banner-overlay {
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.9) 35%,
    rgba(0, 0, 0, 0.1) 100%
  );
}

.banner-content {
  position: relative;
  z-index: 1;
  max-width: 600px;
  color: #ffffff;
}

.banner-tag {
  display: block;
  margin-bottom: 0.5rem;
  color: #ff453a;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.banner-content h2 {
  margin: 0 0 0.8rem;
  font-size: 2rem;
}

.banner-content p {
  margin: 0 0 2rem;
  color: #dddddd;
  line-height: 1.5;
