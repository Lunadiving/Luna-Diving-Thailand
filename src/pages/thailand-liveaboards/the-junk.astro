    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---

<Layout
  title="The Junk Liveaboard | Historic Sailing Junk to the Similans"
  description="Dive the Similan Islands, Surin and Richelieu Rock on The Junk, a 1962 teak sailing junk seen in a James Bond film. 18 guests, 6 cabins, 5-day trips from USD 920."
  image="/images/liveaboard/the-junk/the-junk-similan-islands-liveabaord.webp"
>
  <main class="pcom-wrapper">
    <Breadcrumb />
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">Historic Teak Sailing Junk</span>
      <h1 class="pcom-title">{vesselName} Liveaboard Thailand</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <OptimizedImage 
                src={slide.img} 
                alt={`${vesselName} - ${slide.text}`} 
                loading={index === 0 ? "eager" : "lazy"}
                decoding={index === 0 ? "sync" : "async"}
                widths={[480, 800, 1200]}
                sizes="(max-width: 1200px) 100vw, 1200px"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.text}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">Similan Islands Liveaboard on a Historic Sailing Junk</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          <strong>The Junk</strong>, originally named <em>June Hong Chian Lee</em>, is a <strong>30-metre teak sailing junk built in Penang, Malaysia, in 1962</strong>. With three traditional masts, 330 square metres of sail and room for just <strong>18 guests in 6 en-suite cabins</strong>, she runs <strong>Similan Islands liveaboard trips</strong> to the Similans, Koh Bon, Koh Tachai, the Surin Islands and <strong>Richelieu Rock</strong>.
        </p>
        <p class="paragraph">
          If you want a liveaboard with real character, this is it: a wooden ship with a history, a small group of divers and some of the best diving in Thailand.
        </p>

        <h3 class="sub-heading">From Coal Boat to James Bond Film Star</h3>
        <p class="paragraph">
          The Junk began her working life carrying coal along the coast. In 1997 she changed owners and was rebuilt in Thailand as a diving liveaboard. Along the way she also found fame on screen, appearing in the James Bond film <em>The Man with the Golden Gun</em> and in <em>Swiss Family Robinson</em>. Her carved bow still carries her original name.
        </p>

        <h3 class="sub-heading">Similan, Surin and Richelieu Rock Trips</h3>
        <p class="paragraph">
          During the Similan season she runs 5-day and 7-day trips from Tab Lamu in Khao Lak to the Similan Islands, Koh Bon, Koh Tachai, the Surin Islands and Richelieu Rock, with up to 14 dives on the 5-day trip. In the low season she offers 4-day Southern Andaman trips from Chalong in Phuket, and in December there is a special 9-day Shark Education trip.
        </p>

        <h3 class="sub-heading">Teak Decks, Sails and Shade</h3>
        <p class="paragraph">
          Life on board happens on deck. The main deck is covered by a canvas awning, with long teak tables where meals are served and dive tanks racked along the sides. Up top, the sun deck has wooden loungers, beanbags and a shade awning, with views along the bowsprit and up into the sails.
        </p>

        <h3 class="sub-heading">Air-Conditioned Saloon and Meals</h3>
        <p class="paragraph">
          Inside, the air-conditioned saloon has wooden tables, cushioned benches and a library of books and CDs. Breakfast, lunch, dinner and snacks are all included, with drinking water, tea, coffee and soft drinks available throughout the trip.
        </p>

        <h3 class="sub-heading">Six Cabins with Private Bathrooms</h3>
        <p class="paragraph">
          All six cabins are on the lower deck, panelled in polished teak, with air conditioning and a private bathroom with hot shower. There are two double or twin cabins, two triple cabins that can also be set up as a double or twin, and two quadruple cabins with bunk beds, a good-value choice for groups of friends.
        </p>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box">
          <h3 class="sidebar-heading">Ready to Dive?</h3>
          <p class="sidebar-text">With only 18 places per trip, The Junk fills up quickly in peak season. Check availability for your dates.</p>
          <a href="/contact/?vessel=The%20Junk" class="pcom-btn-primary">
            Check Availability
          </a>
        </div>
      </div>
    </section>

    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">The Junk Prices 2026/27</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Prices in US dollars per person for the 5-day, 4-night Similan and Surin trip with up to 14 dives. Prices for 7-day and special trips on request.</p>
        <div class="heading-line"></div>
      </div>
      
      <div class="pcom-cabins-list">
        {cabins.map((cabin) => (
          <div class="cabin-rate-card">
            <div class="cabin-main-info">
              <h3 class="cabin-name">{cabin.name}</h3>
              <span class="cabin-location">{cabin.location}</span>
              <p class="cabin-details">{cabin.details}</p>
              <span class="cabin-trip-tag">{cabin.trip}</span>
            </div>
            <div class="cabin-price-zone">
              <span class="price-amount">{cabin.price}</span>
              <span class="price-label">Per Person</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Included In The Price
          </h3>
          <ul class="details-list">
            {includedItems.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Not Included / Extra Fees
          </h3>
          <ul class="details-list">
            {notIncludedItems.map((item) => (
              <li class="details-item exc-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <div class="exc-text-wrapper">
                  <span class="exc-main-text">{item.text}</span>
                  {item.highlight && <span class="exc-highlight">{item.highlight}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">The Junk Schedule 2026/27</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Upcoming departures. Tablamu is Tab Lamu pier in Khao Lak; Southern trips start and end at Chalong, Phuket.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Departure Dates</th>
              <th>Itinerary</th>
              <th>Start / Finish Port</th>
              <th class="table-action-header">Action</th>
            </tr>
          </thead>
          <tbody>
            {upcomingSchedule.map((row) => (
              <tr>
                <td class="td-dates">{row.dates}</td>
                <td class="td-itinerary">
                  <span class="itinerary-text">{row.itinerary}</span>
                  <span class={`type-badge badge-${row.type.toLowerCase().replace(/\s+/g, '-')}`}>
                    {row.type}
                  </span>
                </td>
                <td class="td-route">{row.route}</td>
