// Nasconde le partenze già passate (aggiornato a ogni build)
const MONTHS: Record<string, number> = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5, Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11 };
const departureDate = (dates: string) => {
  const [start, end] = dates.split(' - ');
  const [startDay, startMonth] = start.split(' ');
  const [, endMonth, endYear] = end.split(' ');
  let year = 2000 + Number(endYear);
  if (MONTHS[startMonth] > MONTHS[endMonth]) year -= 1;
  return new Date(year, MONTHS[startMonth], Number(startDay));
};
const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingSchedule = schedule.filter((row) => departureDate(row.dates) >= today);

const faqs = [
