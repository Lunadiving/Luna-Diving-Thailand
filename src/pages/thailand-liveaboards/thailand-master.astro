---
import Breadcrumb from '../../components/Breadcrumb.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import Layout from '../../layouts/Layout.astro';

const vesselName = "Thailand Master";
const tagline = "A traditional Indonesian phinisi with red sails, diving the Similan Islands, Richelieu Rock and the Mergui Archipelago for just 18 guests";

const slideshow = [
  { img: '/images/liveaboard/thailand-master/thailand-master-thailand-liveaboard.webp', text: 'Thailand Master, officially Cheng I Sao, a traditional Indonesian phinisi sailing under her red sails.' },
  { img: '/images/liveaboard/thailand-master/thailand-master-similan-islands-liveaboard.webp', text: 'Aerial view of Thailand Master with red sails set over turquoise water in the Andaman Sea.' },
  { img: '/images/liveaboard/thailand-master/thailand-master-main-deck.webp', text: 'Shaded aft dive deck with tank racks and the stairs leading down to the water.' },
  { img: '/images/liveaboard/thailand-master/thailand-master-dive-deck.webp', text: 'Dive stations along the side deck, with each guest\'s BCD and regulator set up on its own tank.' },
  { img: '/images/liveaboard/thailand-master/thailand-master-saloon.webp', text: 'Wooden saloon with cushioned benches, bar stools and polished teak floors.' },
  { img: '/images/liveaboard/thailand-master/thailand-master-indoor-dining-area.webp', text: 'Indoor lounge and bar area with TV and a charging station for cameras and dive computers.' },
  { img: '/images/liveaboard/thailand-master/the-phinisi-dining-area.webp', text: 'Outdoor dining deck with a wooden table and folding chairs under the canopy.' },
  { img: '/images/liveaboard/thailand-master/thailand-master-sun-deck.webp', text: 'Shaded upper deck with red beanbags, tables and sun loungers for relaxing between dives.' },
  { img: '/images/liveaboard/thailand-master/thailand-master-double-cabin.webp', text: 'Double cabin with a large bed, wooden panelling, air conditioning and private bathroom.' },
  { img: '/images/liveaboard/thailand-master/thailand-master-twin-cabin.webp', text: 'Twin cabin with two single beds, air conditioning, fan and en-suite bathroom.' },
  { img: '/images/liveaboard/thailand-master/thaialnd-master-twin-double-cabin.webp', text: 'Double or twin cabin with two beds that can be joined, and private bathroom.' },
  { img: '/images/liveaboard/thailand-master/thailand-master-quad-cabin.webp', text: 'Quadruple cabin with two sets of bunk beds and private bathroom, ideal for friends diving together.' }
];

const technicalSpecs = [
  { label: 'Type', value: 'Indonesian Phinisi Liveaboard' },
  { label: 'Official Name', value: 'Cheng I Sao' },
  { label: 'Built / Refit', value: 'Indonesia 2007 / 2018' },
  { label: 'Guests', value: 'Up to 18 Divers' },
  { label: 'Cabins', value: '7, All En Suite' },
  { label: 'Itineraries', value: '7 to 11 Days' },
  { label: 'Departure Ports', value: 'Chalong, Tab Lamu & Ranong' },
  { label: 'Destinations', value: 'Similan, Surin, Richelieu Rock, Mergui' }
];

const cabins = [
  {
    name: 'Double/Twin Cabin',
    price: '1,580$',
    location: 'Lower Deck – 2 Cabins',
    details: 'Double or Twin – Private Bathroom – Hot Shower – Air Con & Fan',
    trip: 'Per Person – Itinerary on Request'
  },
  {
    name: 'Twin Cabin',
    price: '1,580$',
    location: 'Lower Deck – 3 Cabins',
    details: 'Twin Bed – Private Bathroom – Hot Shower – Air Con & Fan',
    trip: 'Per Person – Itinerary on Request'
  },
  {
    name: 'Quad Cabin',
    price: '1,180$',
    location: 'Lower Deck – 2 Cabins',
    details: 'Bunk Beds – Private Bathroom – Hot Shower – Air Con & Fan',
    trip: 'Per Person – Itinerary on Request'
  }
];

const includedItems = [
  'Transfer Phuket / Khao Lak Hotel to the Vessel and return',
  'Accommodation in selected private or shared luxury cabin',
  'All meals on board (Breakfast, Lunch, Dinner buffet style)',
  'Fresh water, tea, coffee, snacks, and soft drinks',
  'Towels and warm drinks after every dive',
  'Full dive guiding services with small groups',
  'Scuba cylinders, weights, and weight belt'
];

const notIncludedItems = [
  { text: 'Diving Accident Insurance', highlight: 'Compulsory' },
  { text: 'Alcoholic beverages and espresso coffees', highlight: 'Available on board' },
  { text: 'Marine Park Fees & Port Taxes', highlight: 'Cash on board' },
  { text: 'Mergui Archipelago Visa & Entry Fees (Myanmar trips)', highlight: 'Required' },
  { text: 'Rental diving equipment & Dive computer', highlight: 'Available on request' },
  { text: 'Crew and Guide Gratuities / Tips', highlight: 'Optional' }
];

const schedule = [
  { dates: "18 Oct - 26 Oct 26", itinerary: "9D/8N Best of Thailand", route: "Chalong / Tablamu", type: "Best of Thailand", isSoldOut: false },
  { dates: "27 Oct - 04 Nov 26", itinerary: "9D/8N Best of Thailand", route: "Tablamu / Chalong", type: "Best of Thailand", isSoldOut: false },
  { dates: "05 Nov - 15 Nov 26", itinerary: "11D/10N Best of Thailand", route: "SOLD OUT", type: "Best of Thailand", isSoldOut: true },
  { dates: "16 Nov - 26 Nov 26", itinerary: "11D/10N Best of Thailand", route: "Tablamu / Chalong", type: "Best of Thailand", isSoldOut: false },
  { dates: "27 Nov - 03 Dec 26", itinerary: "7D/6N Similan & Surin", route: "Chalong / Tablamu", type: "Similan & Surin", isSoldOut: false },
  { dates: "04 Dec - 12 Dec 26", itinerary: "9D/8N Best of Thailand", route: "Tablamu / Chalong", type: "Best of Thailand", isSoldOut: false },
  { dates: "13 Dec - 21 Dec 26", itinerary: "9D/8N Best of Thailand", route: "SOLD OUT", type: "Best of Thailand", isSoldOut: true },
  { dates: "22 Dec - 30 Dec 26", itinerary: "9D/8N Best of Thailand", route: "Chalong / Tablamu", type: "Best of Thailand", isSoldOut: false },
  { dates: "30 Dec 26 - 05 Jan 27", itinerary: "7D/6N Similan & Surin", route: "Tablamu / Tablamu", type: "Similan & Surin", isSoldOut: false },
  { dates: "06 Jan - 20 Jan 27", itinerary: "Charter", route: "SOLD OUT", type: "Charter", isSoldOut: true },
  { dates: "21 Jan - 28 Jan 27", itinerary: "8D/7N Mergui Archipelago", route: "Ranong / Ranong", type: "Mergui Archipelago", isSoldOut: false },
  { dates: "29 Jan - 05 Feb 27", itinerary: "8D/7N Mergui Archipelago", route: "Ranong / Ranong", type: "Mergui Archipelago", isSoldOut: false },
  { dates: "14 Feb - 24 Feb 27", itinerary: "11D/10N Mergui Archipelago", route: "Ranong / Ranong", type: "Mergui Archipelago", isSoldOut: false },
  { dates: "25 Feb - 04 Mar 27", itinerary: "8D/7N Mergui Archipelago", route: "SOLD OUT", type: "Mergui Archipelago", isSoldOut: true },
  { dates: "05 Mar - 15 Mar 27", itinerary: "11D/10N Mergui Archipelago", route: "SOLD OUT", type: "Mergui Archipelago", isSoldOut: true },
  { dates: "16 Mar - 23 Mar 27", itinerary: "8D/7N Mergui Archipelago", route: "Ranong / Ranong", type: "Mergui Archipelago", isSoldOut: false },
  { dates: "24 Mar - 31 Mar 27", itinerary: "8D/7N Mergui Archipelago", route: "Ranong / Ranong", type: "Mergui Archipelago", isSoldOut: false },
  { dates: "02 Apr - 12 Apr 27", itinerary: "11D/10N Mergui Archipelago", route: "SOLD OUT", type: "Mergui Archipelago", isSoldOut: true },
  { dates: "13 Apr - 23 Apr 27", itinerary: "11D/10N Best of Thailand", route: "Chalong / Tablamu", type: "Best of Thailand", isSoldOut: false },
  { dates: "24 Apr - 30 Apr 27", itinerary: "7D/6N Similan & Surin", route: "SOLD OUT", type: "Similan & Surin", isSoldOut: true },
  { dates: "30 Apr - 08 May 27", itinerary: "9D/8N Best of Thailand", route: "Chalong / Tablamu", type: "Best of Thailand", isSoldOut: false }
];

// Nasconde le partenze già passate (aggiornato a ogni build)
const MONTHS: Record<string, number> = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5, Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11 };
const departureDate = (dates: string) => {
  const [start, end] = dates.split(' - ');
  const [startDay, startMonth] = start.split(' ');
  const [, endMonth, endYear] = end.split(' ');
  let year = 2000 + Number(endYear);
  if (MONTHS[startMonth] > MONTHS[endMonth]) year -= 1;
  return new Date(year, MONTHS[startMonth], Number(startDay));
};
const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingSchedule = schedule.filter((row) => departureDate(row.dates) >= today);

const faqs = [
  {
    q: 'What kind of boat is Thailand Master?',
    a: 'Thailand Master, officially named Cheng I Sao, is a traditional Indonesian phinisi: a wooden sailing ship with red sails, built in Indonesia in 2007. She has worked in Indonesia, the Andaman Islands and the Maldives, and has been diving in Thailand and Myanmar since 2018.'
  },
  {
    q: 'Which itineraries does Thailand Master offer?',
    a: 'She runs 7-day Similan and Surin trips, 9 and 11-day Best of Thailand trips covering the Similan Islands, Koh Bon, Koh Tachai, the Surin Islands and Richelieu Rock, and 8 and 11-day Mergui Archipelago trips from Ranong into Myanmar. Private charters of the whole boat are also possible.'
  },
  {
    q: 'Where does the boat depart from?',
    a: 'Best of Thailand trips start or finish at Chalong in Phuket or Tab Lamu in Khao Lak, Similan and Surin trips depart from Tab Lamu, and Mergui Archipelago trips start and end in Ranong. Transfers from hotels in Phuket and Khao Lak to the boat are included.'
  },
  {
    q: 'How many guests are on board?',
    a: 'A maximum of 18 guests in 7 cabins: two double cabins, three twin cabins and two quadruple cabins, all with a private bathroom, hot shower, individually controlled air conditioning and a fan. The small group size means less crowded dive sites and more space on board.'
  },
  {
    q: 'Do I need a visa for the Mergui Archipelago trips?',
    a: 'Yes. Mergui Archipelago trips cross into Myanmar, and the visa and entry fees are not included in the price. We will send you the current requirements when you book, together with the marine park fees and port taxes, which are paid in cash on board.'
  },
  {
    q: 'What is included in the price?',
    a: 'Hotel transfers from Phuket or Khao Lak, your cabin, all meals served buffet-style, water, tea, coffee, snacks and soft drinks, towels and warm drinks after every dive, guided dives in small groups, tanks, weights and belt. Dive insurance, alcohol, espresso, park fees, port taxes, Myanmar fees, rental equipment and tips are extra.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const whatsappUrl = `https://wa.me/66918233120?text=${encodeURIComponent("Hi Luna Diving! I'm interested in booking the Thailand Master liveaboard.")}`;
---

<Layout
  title="Thailand Master Phinisi Liveaboard | Similan & Mergui"
  description="Dive the Similan Islands, Richelieu Rock and the Mergui Archipelago on Thailand Master, a traditional Indonesian phinisi with red sails for just 18 guests in 7 cabins."
  image="/images/liveaboard/thailand-master/thailand-master-thailand-liveaboard.webp"
>
  <main class="pcom-wrapper">
    <Breadcrumb />
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">Traditional Phinisi Dive Liveaboard</span>
      <h1 class="pcom-title">{vesselName} Phinisi Liveaboard</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <OptimizedImage 
                src={slide.img} 
                alt={`${vesselName} - ${slide.text}`} 
                loading={index === 0 ? "eager" : "lazy"}
                decoding={index === 0 ? "sync" : "async"}
                widths={[480, 800, 1200]}
                sizes="(max-width: 1200px) 100vw, 1200px"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.text}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">Phinisi Liveaboard Diving in Thailand and Myanmar</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          <strong>Thailand Master</strong>, officially named <strong>Cheng I Sao</strong>, is a <strong>traditional Indonesian phinisi</strong>, a wooden sailing ship with red sails, built in Indonesia in 2007. With room for just <strong>18 guests in 7 en-suite cabins</strong>, she runs dive cruises to the <strong>Similan Islands, Koh Bon, Koh Tachai, the Surin Islands and Richelieu Rock</strong>, and expeditions into the <strong>Mergui Archipelago in Myanmar</strong>.
        </p>
        <p class="paragraph">
          Before returning to Thailand in 2018, she sailed in Indonesia, the Andaman Islands and the Maldives. Today she combines the character of a classic sailing ship with a small, relaxed group of divers.
        </p>

        <h3 class="sub-heading">A Traditional Wooden Sailing Ship</h3>
        <p class="paragraph">
          Phinisi are the traditional cargo schooners of Sulawesi, and Thailand Master keeps their look: a wooden hull, two masts, red sails and polished wood throughout. Under sail between the islands or at anchor at sunset, she is unmistakable.
        </p>

        <h3 class="sub-heading">Best of Thailand, Similan and Mergui Itineraries</h3>
        <p class="paragraph">
          The season includes 7-day Similan and Surin trips, 9 and 11-day <strong>Best of Thailand</strong> trips between Phuket and Khao Lak, and 8 and 11-day <strong>Mergui Archipelago</strong> trips from Ranong, for experienced divers who want remote reefs, pinnacles and empty dive sites. Longer trips mean more time in the water and fewer hours travelling.
        </p>

        <h3 class="sub-heading">Small Groups and a Dedicated Dive Deck</h3>
        <p class="paragraph">
          With a maximum of 18 divers, groups stay small and dive sites never feel crowded. Each guest has a personal dive station along the side deck, the shaded aft deck leads directly down to the water, and there is a charging station inside for cameras, lights and dive computers. Towels and warm drinks are ready after every dive.
        </p>

        <h3 class="sub-heading">Wooden Saloon and Shaded Decks</h3>
        <p class="paragraph">
          The air-conditioned saloon has cushioned benches, an indoor bar, a TV and a stereo, all finished in warm polished wood. Outside, the shaded decks have dining tables, beanbags and loungers, and buffet meals bring together Thai recipes and international favourites.
        </p>

        <h3 class="sub-heading">7 En-Suite Cabins</h3>
        <p class="paragraph">
          All seven cabins are on the lower deck and have a private bathroom with hot shower, individually controlled air conditioning and a fan. There are two double or twin cabins, three twin cabins and two quadruple cabins with bunk beds, a good choice for groups of friends travelling together.
        </p>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box">
          <h3 class="sidebar-heading">Ready to Dive?</h3>
          <p class="sidebar-text">With only 18 places per trip, Thailand Master departures sell out early. Check availability for your dates.</p>
          <a href="/contact/?vessel=Thailand%20Master" class="pcom-btn-primary">
            Check Availability
          </a>
        </div>
      </div>
    </section>

    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">Thailand Master Cabins and Prices</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Prices in US dollars per person. Rates vary by itinerary and length of trip; contact us for the exact price of your departure.</p>
        <div class="heading-line"></div>
      </div>
      
      <div class="pcom-cabins-list">
        {cabins.map((cabin) => (
          <div class="cabin-rate-card">
            <div class="cabin-main-info">
              <h3 class="cabin-name">{cabin.name}</h3>
              <span class="cabin-location">{cabin.location}</span>
              <p class="cabin-details">{cabin.details}</p>
              <span class="cabin-trip-tag">{cabin.trip}</span>
            </div>
            <div class="cabin-price-zone">
              <span class="price-amount">{cabin.price}</span>
              <span class="price-label">Per Person</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Included In The Price
          </h3>
          <ul class="details-list">
            {includedItems.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Not Included / Extra Fees
          </h3>
          <ul class="details-list">
            {notIncludedItems.map((item) => (
              <li class="details-item exc-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <div class="exc-text-wrapper">
                  <span class="exc-main-text">{item.text}</span>
                  {item.highlight && <span class="exc-highlight">{item.highlight}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Thailand Master Schedule 2026/27</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Upcoming departures. Chalong is in Phuket, Tablamu is Tab Lamu pier in Khao Lak, and Mergui trips start and end in Ranong.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Departure Dates</th>
              <th>Itinerary</th>
              <th>Start / Finish Port</th>
              <th class="table-action-header">Action</th>
            </tr>
          </thead>
          <tbody>
            {upcomingSchedule.map((row) => (
              <tr class={row.isSoldOut ? "row-sold-out" : ""}>
                <td class="td-dates">{row.dates}</td>
                <td class="td-itinerary">
                  <span class="itinerary-text">{row.itinerary}</span>
                  <span class={`type-badge badge-${row.type.toLowerCase().replace(/&/g, 'and').replace(/\s+/g, '-')}`}>
                    {row.type}
                  </span>
                </td>
                <td class="td-route">
                  {row.isSoldOut ? <span class="sold-out-text">SOLD OUT</span> : row.route}
                </td>
                <td class="td-action">
                  {row.isSoldOut ? (
                    <span class="table-sold-btn">Sold Out</span>
                  ) : (
                    <a href={`/contact/?vessel=${encodeURIComponent(vesselName)}&date=${encodeURIComponent(row.dates)}`} class="table-book-btn" aria-label={`Book ${row.itinerary} departing ${row.dates}`}>
                      Book
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>


    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Thailand Master: Frequently Asked Questions</h2>
        <div class="heading-line"></div>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">{item.q}</summary>
            <p class="paragraph faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  </main>

  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="pcom-whatsapp-float"
    aria-label="Chat on WhatsApp"
  >
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
</Layout>

<script>
  const slider = document.getElementById('slider') as HTMLDivElement | null;
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement | null;

  if (slider && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft + slideWidth >= slider.scrollWidth - 5) {
        slider.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: slideWidth, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft <= 0) {
        slider.scrollTo({ left: slider.scrollWidth, behavior: 'smooth' });
      } else {
