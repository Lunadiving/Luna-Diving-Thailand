---
import Breadcrumb from '../../components/Breadcrumb.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
// src/pages/thailand-liveaboards/giamani.astro
import Layout from '../../layouts/Layout.astro';

const vesselName = "MV Giamani";
const tagline = "A private 24m liveaboard for up to 10 guests, chartered as a whole boat to the Similan Islands, Koh Bon and Richelieu Rock";

const slideshow = [
  { img: '/images/liveaboard/giamani/mv-giamani-liveaboard-phuket-thailand.webp', text: 'MV Giamani liveaboard vessel cruising in the Andaman Sea Thailand.' },
  { img: '/images/liveaboard/giamani/mv-giamani-liveaboard-dive-deck-platform.webp', text: 'Dive deck on MV Giamani looking aft, with tank racks, benches and the stairs down to the dive platform.' },
  { img: '/images/liveaboard/giamani/mv-giamani-dive-deck-gear-storage.webp', text: 'Spacious dive deck on MV Giamani liveaboard with tank racks and gear storage.' },
  { img: '/images/liveaboard/giamani/mv-giamani-scuba-diving-platform.webp', text: 'Rear view of MV Giamani at anchor, showing the dive platform, entry ladders and the shaded upper deck.' },
  { img: '/images/liveaboard/giamani/mv-giamani-indoor-aircon-salon.webp', text: 'Air-conditioned indoor salon and dining area on MV Giamani liveaboard.' },
  { img: '/images/liveaboard/giamani/mv-giamani-lounge-marine-library.webp', text: 'Indoor lounge area with seating and marine library on MV Giamani.' },
  { img: '/images/liveaboard/giamani/mv-giamani-master-cabin-double-bed.webp', text: 'Spacious master cabin accommodation on MV Giamani liveaboard with double bed.' },
  { img: '/images/liveaboard/giamani/mv-giamani-deluxe-cabin-twin-bunk.webp', text: 'Deluxe cabin on MV Giamani with a double bed, a single bunk above and wooden wardrobe.' },
  { img: '/images/liveaboard/giamani/mv-giamani-upper-deck-dining-area.webp', text: 'Shaded outdoor dining table and lounge deck on MV Giamani.' },
  { img: '/images/liveaboard/giamani/mv-giamani-upper-deck-buffet-lounge.webp', text: 'Buffet setup and outdoor seating area on the upper deck of MV Giamani.' },
  { img: '/images/liveaboard/giamani/mv-giamani-top-sundeck-loungers.webp', text: 'Open top sun deck on MV Giamani, the quietest spot on board for sunbathing between dives.' },
  { img: '/images/liveaboard/giamani/mv-giamani-thai-food-buffet-catering.webp', text: 'Fresh buffet meals and dining service on the upper deck of MV Giamani liveaboard Thailand.' },
];

const technicalSpecs = [
  { label: 'Type', value: 'Dive Liveaboard, Full Charter' },
  { label: 'Year Built', value: '1998' },
  { label: 'Length Overall', value: '24 Meters' },
  { label: 'Hull', value: 'Steel (Iron) Motor Boat' },
  { label: 'Cruising Speed', value: '10-12 Knots' },
  { label: 'Guests', value: '10 Divers or Non-Divers' },
  { label: 'Cabins', value: '5, All En Suite' },
  { label: 'Departure Port', value: 'Chalong Pier, Phuket' },
  { label: 'Destinations', value: 'Similan, Koh Bon, Surin, Richelieu Rock' },
  { label: 'Nitrox', value: 'Available, 300 THB / Tank' }
];

const cabins = [
  {
    name: 'Master Cabin',
    price: 'Included',
    location: 'Upper Deck – 1 Cabin',
    details: 'Double Bed – Private En-suite Bathroom – Hot Shower – Air Conditioning – Panoramic View',
    trip: 'North Andaman Sea & Similan Islands'
  },
  {
    name: 'Deluxe Cabins',
    price: 'Included',
    location: 'Main / Lower Deck – 4 Cabins',
    details: 'Double OR Twin Bunk Beds – Private En-suite Bathroom – Hot Shower – Air Conditioning',
    trip: 'North Andaman Sea & Similan Islands'
  }
];

const includedItems = [
  'Full board accommodation for up to 10 guests (divers or non-divers)',
  'Bottled soft drinks, drinking water, tea, and coffee',
  'Guided dives with professional Divemaster',
  'Scuba tanks (S80), weights, and weight belts',
  'Accident insurance on board'
];

const notIncludedItems = [
  { text: 'National Park Fees', highlight: 'As applicable' },
  { text: 'Beer', highlight: '90 THB' },
  { text: 'Nitrox Tank', highlight: '300 THB / tank' },
  { text: 'Rental dive gear (full set)', highlight: '800 THB / day' },
  { text: 'Dive computer rental', highlight: '300 THB / day' },
  { text: 'Dive torch rental', highlight: '300 THB / day' },
  { text: 'Transfers to and from Chalong Pier', highlight: 'Extra cost' }
];

const schedule = [
  { dates: "Season Charter", itinerary: "North Andaman Sea Expedition", route: "Chalong Pier / Chalong Pier", type: "Similan" },
  { dates: "Custom Dates", itinerary: "Similan, Koh Bon, Richelieu Rock", route: "Chalong Pier / Chalong Pier", type: "Similan" },
  { dates: "Day / Short Trips", itinerary: "Phi Phi or Racha Islands", route: "Chalong Pier / Chalong Pier", type: "Racha-PhiPhi" }
];

const faqs = [
  {
    q: 'Can I book a single cabin on MV Giamani?',
    a: 'No. MV Giamani is chartered only as a whole boat, for a private group of up to 10 guests. This makes her ideal for families, groups of friends, dive clubs and underwater photographers who want the boat, the crew and the itinerary to themselves.'
  },
  {
    q: 'Can non-divers join the charter?',
    a: 'Yes. The charter price covers up to 10 guests, divers or non-divers, so partners and friends can snorkel, relax on the sun deck or explore the islands while the rest of the group dives.'
  },
  {
    q: 'Where does MV Giamani depart from?',
    a: 'All trips depart from Chalong Pier in the south of Phuket. Departures to the North or South Andaman Sea are suggested between 15:30 and 16:30, while trips to Phi Phi or the Racha Islands can leave any time between 07:00 and 21:00. Transfers to and from Chalong Pier are available at extra cost.'
  },
  {
    q: 'Which dive sites does MV Giamani visit?',
    a: 'Multi-day North Andaman Sea trips visit the Similan Islands, Koh Bon, known for manta rays, Koh Tachai, the Surin Islands and Richelieu Rock. Shorter trips go to Phi Phi or the Racha Islands, closer to Phuket.'
  },
  {
    q: 'What is included in the charter price?',
    a: 'Full board for up to 10 guests, soft drinks, drinking water, tea and coffee, guided dives with a professional divemaster, S80 tanks, weights and belts, and accident insurance on board. National park fees, beer, nitrox, rental equipment and transfers to Chalong Pier are extra.'
  },
  {
    q: 'Is MV Giamani good for underwater photographers?',
    a: 'Yes. The dive deck has rinse tanks and dedicated tables for camera equipment, and with only 10 guests on board there is plenty of space to prepare housings and strobes. A private charter also lets the group choose dive sites and timing around the best light.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const whatsappUrl = `https://wa.me/66918233120?text=${encodeURIComponent("Hi Luna Diving! I'm interested in chartering the MV Giamani liveaboard.")}`;
---

<Layout
  title="MV Giamani Private Liveaboard Charter | Similan Islands"
  description="Charter MV Giamani, a private 24m liveaboard for up to 10 divers or non-divers from Phuket: Similan Islands, Koh Bon mantas and Richelieu Rock. Whole-boat charter."
  image="/images/liveaboard/giamani/mv-giamani-liveaboard-phuket-thailand.webp"
>
  <main class="pcom-wrapper">
    <Breadcrumb />
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">Private Full-Charter Dive Liveaboard</span>
      <h1 class="pcom-title">{vesselName} Private Liveaboard Charter</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <OptimizedImage 
                src={slide.img} 
                alt={`${vesselName} - ${slide.text}`}
                loading="lazy"
                widths={[480, 800, 1200]}
                sizes="(max-width: 1200px) 100vw, 1200px"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.text}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">Private Liveaboard Charter in Thailand</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          <strong>MV Giamani</strong> is a <strong>24-metre dive liveaboard</strong> that is chartered only as a <strong>whole boat for a private group of up to 10 guests</strong>. Departing from Chalong Pier in Phuket, she takes your group to the best dive sites of the Andaman Sea, including the <strong>Similan Islands, Koh Bon, Koh Tachai, the Surin Islands and Richelieu Rock</strong>, on your own dates and your own schedule.
        </p>
        <p class="paragraph">
          With no other passengers on board, a private liveaboard charter is the best way for families, groups of friends, dive clubs and photographers to enjoy the Similans together. Divers and non-divers can travel together, and the charter price covers the whole group.
        </p>

        <h3 class="sub-heading">A Classic Steel Motor Boat, Built in 1998</h3>
        <p class="paragraph">
          Built in 1998, MV Giamani is a sturdy steel motor boat with warm wooden interiors and a cruising speed of 10 to 12 knots. Her small size and limited guest numbers give every charter a relaxed, family atmosphere that larger liveaboards cannot match.
        </p>

        <h3 class="sub-heading">Dive Koh Bon, the Similans and Richelieu Rock</h3>
        <p class="paragraph">
          Multi-day North Andaman Sea trips cover the classic Similan route: the granite boulders of the Similan Islands, Koh Bon, well known for manta ray sightings, Koh Tachai, the Surin Islands and Richelieu Rock. For a shorter break, the boat also runs trips to Phi Phi and the Racha Islands, closer to Phuket.
        </p>

        <h3 class="sub-heading">A Dive Deck Made for Photographers</h3>
        <p class="paragraph">
          The spacious dive deck has tank racks, gear storage, rinse tanks and dedicated tables for cameras and housings, with stairs leading down to a large dive platform at the stern. Dives are guided by a professional divemaster, S80 tanks, weights and belts are included, and nitrox and rental equipment are available on board.
        </p>

        <h3 class="sub-heading">Indoor Lounge and Outdoor Dining Deck</h3>
        <p class="paragraph">
          The air-conditioned indoor lounge has comfortable sofas, a marine biology library, a stereo system and a TV. Thai and international food is served buffet-style at the shaded outdoor dining table, and the deck sofas and open top sun deck are perfect for reading or a siesta between dives.
        </p>

        <h3 class="sub-heading">Five En-Suite Cabins</h3>
        <p class="paragraph">
          MV Giamani has five air-conditioned cabins, all with a private bathroom and hot shower: a master cabin with a double bed on the upper deck, and four deluxe cabins on the main and lower decks with a double bed or twin bunk beds.
        </p>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box" style="background: #fafafa; border: 1px solid var(--pcom-color-surface); padding: 32px 24px; border-radius: 6px; text-align: left;">
          <h3 class="sidebar-heading" style="font-size: 16px; font-weight: 700; text-transform: uppercase; margin: 0 0 12px 0;">Ready to Charter?</h3>
          <p class="sidebar-text" style="font-size: 13.5px; color: var(--pcom-color-text-muted); line-height: 1.5; margin: 0 0 20px 0;">MV Giamani is priced for the whole boat, for up to 10 guests (divers or non-divers). Tell us your dates and group size for a quote.</p>
          <a href="/contact/?vessel=MV%20Giamani" class="pcom-btn-primary" style="display: block; text-align: center; background: var(--pcom-color-primary); color: #fff; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; padding: 12px; border-radius: 4px; text-decoration: none;">
            Request a Charter Quote
          </a>
        </div>
      </div>
    </section>

    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">Cabins and Charter Price</h2>
        <p class="paragraph" style="margin-bottom: 12px;">All five cabins are included in the whole-boat charter. Prices depend on dates, itinerary and length of trip and are quoted on request.</p>
        <div class="heading-line"></div>
      </div>
      
      <div class="pcom-cabins-list">
        {cabins.map((cabin) => (
          <div class="cabin-rate-card">
            <div class="cabin-main-info">
              <h3 class="cabin-name">{cabin.name}</h3>
              <span class="cabin-location">{cabin.location}</span>
              <p class="cabin-details">{cabin.details}</p>
              <span class="cabin-trip-tag">{cabin.trip}</span>
            </div>
            <div class="cabin-price-zone">
              <span class="price-amount">{cabin.price}</span>
              <span class="price-label">In the Full Charter</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Included In The Price
          </h3>
          <ul class="details-list">
            {includedItems.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Not Included / Extra Fees
          </h3>
          <ul class="details-list">
            {notIncludedItems.map((item) => (
              <li class="details-item exc-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <div class="exc-text-wrapper">
                  <span class="exc-main-text">{item.text}</span>
                  {item.highlight && <span class="exc-highlight">{item.highlight}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Departures from Chalong Pier, Phuket</h2>
        <div class="heading-line"></div>
      </div>

      <div style="background: #fafafa; border: 1px solid var(--pcom-color-surface); padding: 20px; border-radius: 6px; margin-bottom: 24px; text-align: left;">
        <h4 style="margin: 0 0 8px 0; font-size: 14px; text-transform: uppercase; font-weight: 700;">Departure from Chalong Pier</h4>
        <p style="margin: 0 0 6px 0; font-size: 13.5px; color: var(--pcom-color-text-muted);">● North or South Andaman Sea - suggested 15:30 - 16:30</p>
        <p style="margin: 0; font-size: 13.5px; color: var(--pcom-color-text-muted);">● Phi Phi or Racha islands - any time between 07:00 and 21:00 hrs</p>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Departure Dates</th>
              <th>Itinerary</th>
              <th>Start / Finish Port</th>
              <th class="table-action-header">Action</th>
            </tr>
          </thead>
          <tbody>
            {schedule.map((row) => (
              <tr>
                <td class="td-dates">{row.dates}</td>
                <td class="td-itinerary">
                  <span class="itinerary-text">{row.itinerary}</span>
                  <span class={`type-badge badge-${row.type.toLowerCase().replace(/\s+/g, '-')}`}>
                    {row.type}
                  </span>
                </td>
                <td class="td-route">{row.route}</td>
                <td class="td-action">
                  <a href={`/contact/?vessel=${encodeURIComponent(vesselName)}&date=${encodeURIComponent(row.dates)}`} class="table-book-btn" aria-label={`Inquire about ${row.itinerary}`}>
                    Inquire
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>


    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">MV Giamani Charter: Frequently Asked Questions</h2>
        <div class="heading-line"></div>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">{item.q}</summary>
            <p class="paragraph faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <a 
      href={whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="pcom-whatsapp-float"
      aria-label="Chat on WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

  </main>
</Layout>

<script>
  const slider = document.getElementById('slider') as HTMLDivElement | null;
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement | null;

  if (slider && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft + slideWidth >= slider.scrollWidth - 5) {
        slider.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: slideWidth, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft <= 0) {
        slider.scrollTo({ left: slider.scrollWidth, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: -slideWidth, behavior: 'smooth' });
      }
    });
  }
</script>

<style>
  :root {
    --pcom-font: "Next", "Arial Narrow", Arial, sans-serif;
    --pcom-color-canvas: #fff;
    --pcom-color-primary: #010205;
    --pcom-color-surface: #f1f1f4;
    --pcom-color-accent: #008EA7;
    --pcom-color-danger: #b31010;
    --pcom-color-text-muted: #4f5059;
    
    --pcom-space-md: clamp(16px, 1.25vw + 12px, 36px);
    --pcom-space-lg: clamp(32px, 2.75vw + 23px, 76px);
  }

  .pcom-wrapper {
    background-color: var(--pcom-color-canvas);
    min-height: 100vh;
    font-family: var(--pcom-font);
    color: var(--pcom-color-primary);
    width: 100%;
    box-sizing: border-box;
    padding-top: clamp(100px, 10vw, 140px);
    display: flex;
    flex-direction: column;
    align-items: center;
    -webkit-font-smoothing: antialiased;
  }

  /* Hero */
  .pcom-hero {
    width: 100%;
    box-sizing: border-box;
    max-width: 820px;
    padding: 0 var(--pcom-space-md);
    text-align: center;
    margin-bottom: var(--pcom-space-md);
  }

  .pcom-subtitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--pcom-color-accent);
    display: block;
    margin-bottom: 12px;
  }

  .pcom-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 16px 0;
    line-height: 1.1;
  }

  .pcom-divider {
    width: 60px;
    height: 2px;
    background-color: var(--pcom-color-primary);
    margin: 0 auto 16px auto;
  }

  .pcom-tagline {
    font-size: clamp(11px, 1.5vw, 13px);
    color: var(--pcom-color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
  }

  /* Specs */
  .pcom-specs-container {
    width: 100%;
    background-color: #fafafa;
    border-top: 1px solid var(--pcom-color-surface);
    border-bottom: 1px solid var(--pcom-color-surface);
    padding: 24px 0;
    margin-bottom: var(--pcom-space-lg);
  }

  .pcom-specs-grid {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 var(--pcom-space-md);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media (min-width: 768px) {
    .pcom-specs-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
