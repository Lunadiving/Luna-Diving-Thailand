---
import Breadcrumb from '../../components/Breadcrumb.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
// src/pages/thailand-yachts/song-of-songs.astro
import Layout from '../../layouts/Layout.astro';

const vesselName = "Song of Songs";
const tagline = "A 42m Heysea superyacht for all-inclusive day charters and private cruises from Phuket across Thailand, Mergui and Southeast Asia";

const slideshow = [
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-luxury-superyacht-stern-twilight.webp', 
    text: 'Aerial twilight view of the Song of Songs superyacht anchored with blue underwater LED lights, tender, jet skis, and water toys' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-superyacht-profile-sunset-phuket.webp', 
    text: 'Side profile view of the 139ft Song of Songs luxury superyacht cruising at sunset off Phuket with water toys alongside' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-aft-deck-beach-club-dusk.webp', 
    text: 'Stern and beach club platform of the Song of Songs superyacht illuminated with blue LED lighting at dusk' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-master-suite-interior.webp', 
    text: 'Spacious master suite cabin with king-size bed, elegant ambient lighting, desk, and light wood finishes aboard Song of Songs' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-master-ensuite-bathroom-marble.webp', 
    text: 'Luxury master ensuite bathroom featuring marble vanities, modern fixtures, and glass shower enclosure' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-vip-cabin-double-bed.webp', 
    text: 'Opulent VIP cabin suite with plush double bed, warm accent lighting, and decorative throw blanket' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-twin-guest-cabin.webp', 
    text: 'Modern twin guest cabin with two single beds, custom lighting, and stylish interior finishes on Song of Songs' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-upper-deck-alfresco-dining.webp', 
    text: 'Covered upper deck alfresco dining area elegantly set for dinner with blue mood lighting and plush seating' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-main-deck-salon-lounge.webp', 
    text: 'Panoramic main deck saloon with contemporary white sofas, large TV screen, and floor-to-ceiling windows' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-formal-dining-room-chandelier.webp', 
    text: 'Elegant formal dining room featuring a marble table, crystal chandelier, and large windows with ocean views aboard Song of Songs' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-master-stateroom-panoramic-view.webp', 
    text: 'Master stateroom suite with king bed, lounge seating, large TV screen, and panoramic ocean view balcony doors' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-foredeck-jacuzzi-sunpad-lounge.webp', 
    text: 'Guests relaxing in the foredeck Jacuzzi hot tub surrounded by sunpads and lounge seating on Song of Songs' 
  }
];

const technicalSpecs = [
  { label: 'Builder / Model', value: 'Heysea Yachts / Asteria 142' },
  { label: 'Year Built', value: '2022' },
  { label: 'Type', value: 'Motor Yacht' },
  { label: 'Length Overall', value: '42.27 m / 139 ft' },
  { label: 'Beam / Draft', value: '8.50 m / 1.97 m' },
  { label: 'Engines', value: '2 x Caterpillar C-32' },
  { label: 'Cruising / Max Speed', value: '10 / 15 Knots' },
  { label: 'Range', value: '2,000+ Nautical Miles' },
  { label: 'Fuel / Water', value: '26,300 L / 5,000 L' },
  { label: 'Cabins', value: '6 (Master, 2 VIP, 3 Guest)' },
  { label: 'Guests', value: '12 Overnight / 20 Day' },
  { label: 'Crew', value: '10, plus Captain Gordon Ross' },
  { label: 'Home Port', value: 'Ao Po Grand Marina, Phuket' }
];

const packageRates = [
  { type: 'Day Charter (8 Hours)', priceUSD: '$37,500', notes: 'Up to 12 guests. All inclusive rate.' },
  { type: 'Two Full Days, One Night', priceUSD: '$46,000', notes: 'Up to 12 guests. All inclusive rate.' }
];

const packageSupplements = [
  { item: 'Additional Guest above 12', rate: '$600 per person' },
  { item: 'Premium Food & Beverage Supplement (Day Charter)', rate: '$2,500' },
  { item: 'Premium Food & Beverage Supplement (Two Day Package)', rate: '$5,000' }
];

const nightlyWorkedExample = [
  { item: 'Charter Fee (7 Nights @ $25,000 / night)', amount: '$175,000' },
  { item: 'Tax (15% for Thai waters)', amount: '$26,250' },
  { item: 'Advance Provisioning Allowance (APA 25%)', amount: '$43,750' },
  { item: 'Total Payable Before Departure', amount: '$245,000' }
];

const includedInPackage = [
  'Captain, engineer and professional crew',
  'Two Sea-Doo jet skis, paddleboards, wakeboard, waterskis and snorkelling gear',
  'Champagne, Prosecco, house wines, cocktails and all beverages',
  'All meals, snacks and refreshments',
  'Fuel for cruising and for water sports',
  'National park permits and conservation fees',
  'Airport transfers on arrival and departure',
  'Satellite communications and Wi-Fi'
];

const includedInNightly = [
  'Captain, engineer and crew',
  'Use of the vessel and of all water toys carried aboard'
];

const metFromApa = [
  'All meals, snacks and beverages',
  'Fuel for the duration of the charter',
  'Excursions, guide fees and park permits',
  'Clearances and conservation fees',
  'Airport transfers',
  'Satellite communications and Wi-Fi',
  'Dockage'
];

const chargedSeparately = [
  { text: 'International and domestic airfares', highlight: 'Excluded' },
  { text: 'Excess baggage and airport taxes', highlight: 'Excluded' },
  { text: 'Travel insurance and personal expenses', highlight: 'Excluded' },
  { text: 'Spa and massage treatments', highlight: 'On request' },
  { text: 'Crew gratuities (discretionary, typically 10% to 15%)', highlight: 'Discretionary' },
  { text: 'Unscheduled excursions & drone usage fees', highlight: 'Where applicable' },
  { text: 'Seabobs, e-foils & additional water sports equipment', highlight: 'Not aboard' },
  { text: 'Scuba diving, dive gear, tank rental and instruction', highlight: 'On request' }
];

const cruisingGrounds = [
  { destination: 'Phang Nga Bay, Krabi and Phi Phi', country: 'Thailand', type: 'Day charter & overnight' },
  { destination: 'Similan and Surin Islands', country: 'Thailand', type: 'Nightly charter' },
  { destination: 'Mergui Archipelago', country: 'Myanmar', type: 'Cross-border charter' },
  { destination: 'Andaman Islands', country: 'India', type: 'Expedition' },
  { destination: 'East Coast of Malaysia', country: 'Malaysia', type: 'Green season (May to October)' },
  { destination: 'The Philippines and Japan', country: 'Asia', type: 'Green season (May to October)' }
];

const waterToysList = [
  "Two jet skis",
  "Tender",
  "Stand-up paddleboards (SUP)",
  "Floating swim platform",
  "Wakeboard & waterskis",
  "Towables and inflatables",
  "Snorkelling and fishing equipment"
];

const onBoard = [
  "Forward deck Jacuzzi",
  "Sun deck wet bar and BBQ grill",
  "Air conditioning throughout",
  "Satellite communications and Wi-Fi",
  "Bluetooth speakers and board games",
  "Safety and medical equipment"
];

const faqs = [
  {
    q: 'How much does a Song of Songs day charter cost?',
    a: 'An 8-hour all-inclusive day charter costs USD 37,500 for up to 12 guests, all year. Crew, meals, Champagne and beverages, fuel, water sports, national park fees and airport transfers are included. Each additional guest above 12 is USD 600, up to a maximum of 20.'
  },
  {
    q: 'How much does an overnight superyacht charter cost?',
    a: 'The all-inclusive two-day, one-night package is USD 46,000 for up to 12 guests. Longer charters run on standard superyacht terms: USD 25,000 per night, plus 15% tax in Thai waters and a 25% advance provisioning allowance. A seven-night charter totals USD 245,000 payable before departure.'
  },
  {
    q: 'What is the advance provisioning allowance (APA)?',
    a: 'On nightly charters, the APA is a prepayment of around 25% of the charter fee that covers running costs such as food, drinks, fuel, park permits, dockage and transfers. The captain provides an expense report at the end of the charter, and any balance is refunded.'
  },
  {
    q: 'How many guests can Song of Songs take?',
    a: 'Up to 12 guests overnight in six cabins, a master suite, two VIP suites and three guest cabins, all with private bathrooms. Day charters can welcome up to 20 guests, which makes her ideal for birthdays, weddings at sea and corporate events.'
  },
  {
    q: 'Where does the yacht depart from?',
    a: 'Song of Songs is based at Ao Po Grand Marina on the north-east coast of Phuket. From November to April she cruises Thailand, including Phang Nga Bay and the Similan Islands, and can travel to the Mergui Archipelago in Myanmar. Bookings require at least 48 hours notice.'
  },
  {
    q: 'Which water toys are on board?',
    a: 'Two jet skis, a tender, stand-up paddleboards, a wakeboard, waterskis, towables, a floating swim platform and snorkelling and fishing gear. Scuba diving can be arranged on request at extra cost; Seabobs and e-foils are not available on this yacht.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---

<Layout
  title="Song of Songs Superyacht Charter Phuket | 42m Heysea"
  description="Charter Song of Songs, a 42m Heysea superyacht in Phuket: all-inclusive day charters for up to 12 guests from USD 37,500, Jacuzzi, jet skis and crew of 10."
  image="/images/yacht/song-of-songs/song-of-songs-luxury-superyacht-stern-twilight.webp"
>
  <main class="pcom-wrapper">
    <Breadcrumb />
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">Heysea Asteria 142 Superyacht</span>
      <h1 class="pcom-title">{vesselName} Superyacht Charter Phuket</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <OptimizedImage 
                src={slide.img} 
                alt={slide.text}
                loading="lazy"
                widths={[480, 800, 1200]}
                sizes="(max-width: 1200px) 100vw, 1200px"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.text}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">Luxury Superyacht Charter in Phuket</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          <strong>Song of Songs</strong> is a <strong>42-metre Heysea Asteria 142 superyacht</strong>, launched in 2022 and based at <strong>Ao Po Grand Marina, Phuket</strong>. She welcomes <strong>up to 12 guests overnight in six cabins</strong> and <strong>up to 20 guests on day charters</strong>, with a crew of ten led by Captain Gordon Ross, who has been at the helm since she left the shipyard.
        </p>
        <p class="paragraph">
          She is the largest yacht in our fleet, and her day charter is sold as an <strong>all-inclusive superyacht package</strong>: one fixed price covers crew, meals, Champagne, fuel, jet skis, national park fees and airport transfers. For longer voyages she sails on standard superyacht terms, as far as the Mergui Archipelago and beyond.
        </p>

        <h3 class="sub-heading">Built by Heysea Yachts</h3>
        <p class="paragraph">
          Heysea, founded in 2007 in Guangdong, China, is one of Asia's leading luxury yacht builders, known for combining European design with Asian engineering. Its range runs from 55-foot cruisers to 150-foot superyachts, and Song of Songs, an Asteria 142, sits near the top of it.
        </p>

        <h3 class="sub-heading">Long-Range Cruising: 2,000+ Nautical Miles</h3>
        <p class="paragraph">
          Twin Caterpillar C-32 engines, 26,300 litres of fuel and 5,000 litres of fresh water give her a range of more than 2,000 nautical miles. From November to April she is based in Thailand; during the green season, May to October, she cruises further afield in Southeast Asia, from the east coast of Malaysia to the Philippines.
        </p>

        <h3 class="sub-heading">Sun Deck with Wet Bar and Dining</h3>
        <p class="paragraph">
          With no helm station on the top deck, the whole sun deck is given over to guests: sun loungers in the open, a long dining table under the hardtop, a full-service wet bar and uninterrupted views. It is the place for sunrise yoga, sunset aperitifs and dinner with the limestone islands of Phang Nga Bay on the horizon.
        </p>

        <h3 class="sub-heading">Forward Deck Jacuzzi</h3>
        <p class="paragraph">
          At the bow, a Jacuzzi is surrounded by large sunpads, lounge seating and alfresco tables, with shade covers when needed. It is the guests' favourite spot on board, whether for a swim break in the afternoon or a glass of Champagne under the stars.
        </p>

        <h3 class="sub-heading">Aft Deck, Beach Platform and Water Toys</h3>
        <p class="paragraph">
          The aft deck is where guests step aboard and where the day often starts and ends, with comfortable seating, breakfast in the shade and direct access to the swim platform. At anchor, the tender, two jet skis, paddleboards and a floating platform are launched from the stern, ready for the water.
        </p>

        <h3 class="sub-heading">Main Saloon and Formal Dining</h3>
        <p class="paragraph">
          The main deck saloon is bright and spacious, with large panoramic windows, neutral tones, custom furniture, curated artworks and fine wood finishes. Forward of it, the dining room seats the whole party around a marble table under a crystal chandelier, with the bar close at hand.
        </p>

        <h3 class="sub-heading">Master Suite and Five Guest Cabins</h3>
        <p class="paragraph">
          The master suite occupies its own space on the upper deck, with a king-size bed, a private lounge, a dressing area, a marble en-suite bathroom with bathtub and a private terrace at the stern. Two VIP suites and three further double and twin cabins complete the accommodation, each with its own bathroom and high-end finishes.
        </p>

        <h3 class="sub-heading">Private Chef and Fine Dining</h3>
        <p class="paragraph">
          A private chef designs every menu around the guests' tastes, from fresh seafood and lobster to wagyu beef and caviar, served with wines chosen to match. On the all-inclusive packages, Champagne, Prosecco, house wines and a classic bar are included, with a premium upgrade available.
        </p>

        <h3 class="sub-heading">Birthdays, Weddings and Corporate Events</h3>
        <p class="paragraph">
          With space for up to 20 guests by day, Song of Songs is made for celebrations: milestone birthdays, intimate weddings at sea, honeymoons, anniversaries and private corporate retreats. The crew personalises every event, and massage treatments can be added on request.
        </p>

        <h3 class="sub-heading">Water Toys and Amenities</h3>
        <ul class="toy-list">
          {waterToysList.map(toy => <li>{toy}</li>)}
        </ul>
        <ul class="toy-list">
          {onBoard.map(item => <li>{item}</li>)}
        </ul>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box">
          <h3 class="sidebar-heading">Inquire for Song of Songs</h3>
          <p class="sidebar-text">Check availability for an all-inclusive day charter or a private cruise on the 42m superyacht Song of Songs, from Ao Po Grand Marina, Phuket. Minimum 48 hours notice.</p>
          <a href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20chartering%20Song%20of%20Songs." target="_blank" rel="noopener noreferrer" class="pcom-btn-primary">
            Inquire via WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Pricing Structure 1: All Inclusive Packages -->
    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">All-Inclusive Superyacht Packages 2026</h2>
        <p class="paragraph" style="margin-bottom: 8px;">Single fixed price. Up to 12 guests. Includes crew, meals, beverages, fuel, water sports, park fees & airport transfers.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Package Duration</th>
              <th>Rate (USD)</th>
              <th>Details</th>
              <th class="table-action-header">Action</th>
            </tr>
          </thead>
          <tbody>
            {packageRates.map((row) => (
              <tr>
                <td class="td-dates">{row.type}</td>
                <td class="td-itinerary"><strong>{row.priceUSD}</strong></td>
                <td class="td-route">{row.notes}</td>
                <td class="td-action">
                  <a href={`https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20booking%20Song%20of%20Songs%20for%20${encodeURIComponent(row.type)}.`} target="_blank" rel="noopener noreferrer" class="table-book-btn">
                    Book
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div style="margin-top: 20px;">
        <h4 style="font-size: 13px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Package Supplements & Upgrades</h4>
        <div class="table-responsive-container">
          <table class="schedule-table">
            <thead>
              <tr>
                <th>Supplement Item</th>
                <th>Rate (USD)</th>
              </tr>
            </thead>
            <tbody>
              {packageSupplements.map((sup) => (
                <tr>
                  <td class="td-dates">{sup.item}</td>
                  <td class="td-itinerary"><strong>{sup.rate}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="table-note-text" style="margin-top: 12px; font-size: 12px; color: #4f5059; line-height: 1.5;">
        * Standard rate includes all meals, Champagne, Prosecco, house wines and classic bar.<br/>
        * Premium supplement upgrades to luxury Champagne, premium wines and top-shelf bar service.
      </p>
    </section>

    <!-- Pricing Structure 2: Nightly Charter & APA -->
    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Nightly Superyacht Charter Rates 2026</h2>
        <p class="paragraph" style="margin-bottom: 8px;">Per 24 hours (Noon to Noon) · $25,000 USD / night for up to 12 guests + Tax + APA.</p>
        <div class="heading-line"></div>
      </div>

      <h4 style="font-size: 13px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Worked Example: 7-Night Charter</h4>
      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Cost Item</th>
              <th>Amount (USD)</th>
            </tr>
          </thead>
          <tbody>
            {nightlyWorkedExample.map((row) => (
              <tr>
                <td class="td-dates">{row.item}</td>
                <td class="td-itinerary"><strong>{row.amount}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note-text" style="margin-top: 12px; font-size: 12px; color: #4f5059; line-height: 1.5;">
        * Advance Provisioning Allowance (APA) is a prepayment against running costs (typically 20–30%). The captain meets fuel, provisioning, dockage and shore costs from it and provides an itemized expense report at charter end. Any balance is refunded or shortfall settled.
      </p>
    </section>

    <!-- Inclusions & Terms Comparison -->
    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            In the All-Inclusive Package Rate
          </h3>
          <ul class="details-list">
            {includedInPackage.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Nightly Rate & APA Breakdown
          </h3>
          <p style="font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">In the Nightly Charter Fee:</p>
          <ul class="details-list" style="margin-bottom: 16px;">
            {includedInNightly.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p style="font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Drawn from APA Allowance:</p>
          <ul class="details-list">
            {metFromApa.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Charged Separately Section -->
    <section class="pcom-details-grid-section">
      <div class="details-column" style="width: 100%; box-sizing: border-box;">
        <h3 class="details-col-title">
          <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Charged Separately (Both Structures)
        </h3>
        <ul class="details-list">
          {chargedSeparately.map((item) => (
            <li class="details-item exc-item">
              <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
              <div class="exc-text-wrapper">
                <span class="exc-main-text">{item.text}</span>
                {item.highlight && <span class="exc-highlight">{item.highlight}</span>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Cruising Grounds Section -->
    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Cruising Grounds in Thailand and Southeast Asia</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Based in Thailand from November to April and cruising further across Southeast Asia from May to October. Destinations, water toys and crew may change with season and access restrictions such as national park closures.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Destination</th>
              <th>Region</th>
              <th>Charter Type</th>
            </tr>
