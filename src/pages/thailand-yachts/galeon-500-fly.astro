---
import OptimizedImage from '../../components/OptimizedImage.astro';
import Layout from '../../layouts/Layout.astro';

const vesselName = "Galeon 500 Fly";
const tagline = "A 16m flybridge motor yacht for private day trips and overnight charters from Royal Phuket Marina";

const slideshow = [
  { img: '/images/yacht/galeon-500-fly/galeon-500-luxury-yacht-cruising-open-water.webp', text: 'Galeon 500 luxury yacht cruising in open waters with a white hull and flybridge.' },
  { img: '/images/yacht/galeon-500-fly/yacht-master-cabin-light-wood-interior.webp', text: 'Luxury master cabin aboard the yacht featuring a double bed, light wood finishes, and large windows.' },
  { img: '/images/yacht/galeon-500-fly/aerial-drone-view-luxury-yacht-sea.webp', text: 'Aerial drone view of the luxury yacht cruising at sea with a tender and water toys.' },
  { img: '/images/yacht/galeon-500-fly/woman-relaxing-bow-sunpad-yacht.webp', text: 'Woman in a red bikini relaxing on the bow sunpad of the luxury yacht from an overhead view.' },
  { img: '/images/yacht/galeon-500-fly/modern-luxury-yacht-bathroom-shower.webp', text: 'Modern and bright yacht bathroom with a glass shower enclosure and a designer basin.' },
  { img: '/images/yacht/galeon-500-fly/woman-standing-spacious-yacht-cabin.webp', text: 'Woman in a white dress standing inside the spacious cabin of a luxury yacht.' },
  { img: '/images/yacht/galeon-500-fly/chef-cooking-stern-galley-yacht.webp', text: 'Crew member plating lunch in the galley, with the aft bar counter opening onto the deck.' },
  { img: '/images/yacht/galeon-500-fly/couple-dining-panoramic-yacht-salon.webp', text: 'Couple enjoying lunch and dining together inside the panoramic main deck salon of a yacht.' },
  { img: '/images/yacht/galeon-500-fly/couple-relaxing-bow-deck-thailand.webp', text: 'Couple relaxing on the bow sun deck of the yacht with scenic island views in Thailand.' },
  { img: '/images/yacht/galeon-500-fly/profile-view-luxury-yacht-aft-bar.webp', text: 'Profile view of the luxury yacht with a couple sitting at the aft deck bar during a charter cruise.' },
  { img: '/images/yacht/galeon-500-fly/luxury-yacht-interior-kitchen-salon.webp', text: 'Interior view of the luxury yacht galley kitchen and main salon overlooking scenic tropical islands.' },
  { img: '/images/yacht/galeon-500-fly/yacht-galley-kitchen-island-ocean-view.webp', text: 'Modern yacht galley kitchen featuring a cooktop and large windows with tropical island views.' }
];
const technicalSpecs = [
  { label: 'Builder / Model', value: 'Galeon Yachts, Poland / 500 Fly' },
  { label: 'Length Overall', value: '16.2 m / 53 ft' },
  { label: 'Beam', value: '4.42 m' },
  { label: 'Cruising Speed', value: '20 Knots' },
  { label: 'Maximum Speed', value: '28 Knots' },
  { label: 'Range', value: '220 Nautical Miles' },
  { label: 'Guests', value: '10 Day / 6 Overnight' },
  { label: 'Cabins / Berths', value: '3 Cabins / 6 Berths' },
  { label: 'Crew', value: '3 (Captain, Deckhand, Hostess)' },
  { label: 'Tender', value: 'Williams Jet Tender' },
  { label: 'Air Conditioning', value: 'Throughout' },
  { label: 'Home Port', value: 'Royal Phuket Marina' }
];

// Tariffe 2026 per charter, IVA 7% inclusa, valide tutto l'anno (USD indicativi a 33 THB)
const cabins = [
  {
    name: 'Day Charter (8 Hours)',
    price: 'THB 162,700',
    usd: 'approx. USD 4,930',
    location: '6 guests included, up to 10 (THB 2,500 / USD 75 per additional guest)',
    details: 'Khai & Naka Islands, Phang Nga Bay, Krabi Four Islands, Phi Phi or Racha Islands. Crew, Set A lunch, drinks, 500 L of fuel and all water toys included.',
    trip: 'Day Trip'
  },
  {
    name: '2 Days / 1 Night',
    price: 'THB 419,800',
    usd: 'approx. USD 12,720',
    location: 'Sleeps 6 guests in 3 cabins',
    details: 'Private overnight charter in the Andaman Sea with captain, deckhand and hostess, water toys and a night at anchor.',
    trip: 'Overnight'
  },
  {
    name: '3 Days / 2 Nights',
    price: 'THB 577,200',
    usd: 'approx. USD 17,490',
    location: 'Sleeps 6 guests in 3 cabins',
    details: 'Two nights of island hopping between Phang Nga Bay, Krabi and Phi Phi at your own pace.',
    trip: 'Overnight'
  }
];

const includedItems = [
  'Full use of the yacht with captain, deckhand and hostess',
  'Set A lunch, fruit and snacks',
  'Soft drinks, ice and 24 bottles of beer',
  'Towels and air conditioning throughout',
  'Williams jet tender, kayak, stand-up paddleboard & snorkelling equipment',
  'Two Airhead towables, 12 ft water trampoline, wakeboard & water skis',
  'Life jackets and insurance',
  'Fuel (500 litres) and 7% VAT'
];

const notIncludedItems = [
  { text: 'Lunch Upgrade Set B (Barbecue)', highlight: 'THB 5,000 / USD 150' },
  { text: 'Lunch Upgrade Set C (Individual Plated Menu)', highlight: 'THB 8,000 / USD 240' },
  { text: 'Return transfers, hotel to marina', highlight: 'On request' },
  { text: 'National park fees', highlight: 'Where charged' },
  { text: 'Alcohol beyond the beer allowance', highlight: 'On request' },
  { text: 'Special catering, therapist, massage or photographer', highlight: 'On request' }
];

const schedule = [
  { dates: "All Year", itinerary: "Day Charter (8 Hours)", route: "Khai & Naka / Phang Nga Bay / Krabi Four Islands / Phi Phi / Racha", type: "Day Trip" },
  { dates: "All Year", itinerary: "2 Days / 1 Night", route: "Andaman Sea islands from Royal Phuket Marina", type: "Overnight" },
  { dates: "All Year", itinerary: "3 Days / 2 Nights", route: "Andaman Sea islands from Royal Phuket Marina", type: "Overnight" }
];

const cruisingDistances = [
  { destination: "Koh Naka Yai", distance: "7 nm", time: "25 min" },
  { destination: "Koh Khai Group", distance: "11 nm", time: "35 min" },
  { destination: "Koh Yao Noi", distance: "12 nm", time: "40 min" },
  { destination: "Phang Nga Bay", distance: "22 nm", time: "1 h 10" },
  { destination: "Racha Yai", distance: "32 nm", time: "1 h 40" },
  { destination: "Krabi, The Four Islands", distance: "33 nm", time: "1 h 40" },
  { destination: "Phi Phi", distance: "38 nm", time: "1 h 55" }
];

const waterToys = [
  "Stand up paddleboard",
  "Kayak",
  "Airhead Orb towable",
  "Airhead Super Slice towable",
  "12 ft water trampoline",
  "Ronix 144 Vault wakeboard",
  "O'Brien Celebrity water skis",
  "Snorkelling equipment (for 10)"
];

const onBoard = [
  "Williams jet tender",
  "Air conditioning throughout",
  "BBQ & grill",
  "WiFi & Bluetooth audio",
  "Towels & beach kit",
  "Life jackets, safety gear & medical kit"
];

const faqs = [
  {
    q: 'How much does a Galeon 500 Fly day charter cost?',
    a: 'An 8-hour private day charter costs THB 162,700 (about USD 4,930) for up to 6 guests, with THB 2,500 (about USD 75) for each additional guest up to a maximum of 10. Rates are per charter, include 7% VAT and apply all year.'
  },
  {
    q: 'How many guests can join the charter?',
    a: 'Up to 10 guests on a day charter and up to 6 guests overnight, in three cabins with six berths. The yacht is run by a crew of three: captain, deckhand and hostess.'
  },
  {
    q: 'Where does the yacht depart from?',
    a: 'All charters depart from Royal Phuket Marina on the east coast of Phuket. Return transfers between your hotel and the marina can be arranged at extra cost.'
  },
  {
    q: 'Which islands can we visit on a day trip?',
    a: 'Day charters can visit Khai and Naka Islands, Phang Nga Bay, the Four Islands of Krabi, Phi Phi or the Racha Islands. At a cruising speed of 20 knots, Phang Nga Bay is about 1 hour 10 minutes away and Phi Phi just under 2 hours.'
  },
  {
    q: 'What is included in the price?',
    a: 'The yacht with crew, Set A lunch, fruit, snacks, soft drinks, ice, 24 bottles of beer, towels, 500 litres of fuel, insurance, 7% VAT and the full water toy inventory: jet tender, kayak, paddleboard, snorkelling gear, two towables, water trampoline, wakeboard and water skis.'
  },
  {
    q: 'Can we upgrade the lunch on board?',
    a: 'Yes. Set A lunch is included. Set B adds a barbecue for THB 5,000 (about USD 150) and Set C is an individual plated menu for THB 8,000 (about USD 240). Please share any dietary requirements when booking.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---

<Layout
  title={`${vesselName} Yacht Charter Phuket | Flybridge Day Trips`}
  description="Private yacht charter in Phuket on the Galeon 500 Fly: 16m flybridge, up to 10 guests by day or 6 overnight, water toys included. Phang Nga Bay, Phi Phi, Krabi."
  image="/images/yacht/galeon-500-fly/galeon-500-luxury-yacht-cruising-open-water.webp"
>
  <main class="pcom-wrapper">
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">16m Flybridge Motor Yacht</span>
      <h1 class="pcom-title">{vesselName} Yacht Charter Phuket</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <OptimizedImage 
                src={slide.img} 
                alt={`${vesselName} - ${slide.text}`}
                loading="lazy"
                widths={[480, 800, 1200]}
                sizes="(max-width: 1200px) 100vw, 1200px"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.text}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">Private Yacht Charter in Phuket on the Galeon 500 Fly</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          The <strong>Galeon 500 Fly</strong> is a <strong>16-metre flybridge motor yacht</strong> based at <strong>Royal Phuket Marina</strong>, available for <strong>private day trips for up to 10 guests</strong> and <strong>overnight charters for up to 6 guests</strong>. With a cruising speed of 20 knots, she reaches Phang Nga Bay, the Four Islands of Krabi and Phi Phi in a fraction of the time of a classic yacht, leaving more hours for swimming, snorkelling and water sports.
        </p>
        <p class="paragraph">
          Built by Galeon Yachts in Gdansk, Poland, the 500 Fly packs the space of a larger yacht into 16 metres: a big flybridge with room for the whole group, a bright main saloon on deck level and three cabins below. A professional crew of three, a captain, a deckhand and a hostess, looks after everything on board.
        </p>

        <h3 class="sub-heading">Fast Island Hopping from Royal Phuket Marina</h3>
        <p class="paragraph">
          Twin diesel engines give the Galeon a cruising speed of 20 knots and a top speed of 28 knots, with a range of more than 200 nautical miles. From the marina, Koh Naka Yai is about 25 minutes away, Phang Nga Bay a little over an hour and Phi Phi just under two hours, so an eight-hour day charter still leaves plenty of time at anchor.
        </p>

        <h3 class="sub-heading">A Flybridge Made for Groups</h3>
        <p class="paragraph">
          The flybridge is the social centre of the yacht, with lounge seating, a full dining table and a wet bar under a sun awning. It stays shaded all day and open to the breeze on three sides, and a second helm station up here keeps the captain close to the group.
        </p>

        <h3 class="sub-heading">Aft Deck, Swim Platform and Bow Sunpad</h3>
        <p class="paragraph">
          The aft deck links the saloon directly to the sea and is the best place to watch the sunset with the tender tied alongside. The bathing platform lowers to swimming height, so getting in and out for a swim is easy for everyone. At the bow, a cushioned sunpad across the full width of the yacht, with a removable drinks table and optional shade, offers a quieter spot to relax away from the action.
        </p>

        <h3 class="sub-heading">Air-Conditioned Saloon and Three Cabins</h3>
        <p class="paragraph">
          On the main deck, the galley, dinette and helm share one open, air-conditioned saloon with windows along almost the full length of both sides, so the view is never lost, even if the weather sends lunch indoors. Below deck, the full-beam master cabin sits amidships with its own en-suite bathroom and an overhead hatch, and two more cabins sleep the remaining four overnight guests.
        </p>

        <h3 class="sub-heading">Lunch on Board</h3>
        <p class="paragraph">
          Meals are prepared by Suay, a Phuket catering kitchen, and served on board by the hostess. Set A lunch is included in every charter; you can upgrade to Set B with a barbecue or Set C with an individual plated menu. Special dietary needs are easily handled when shared at the time of booking.
        </p>

        <h3 class="sub-heading">Water Toys for the Whole Family</h3>
        <p class="paragraph">
          The water toy collection is one of the main reasons guests book this yacht again. From towables and a 12 ft water trampoline to a wakeboard and water skis, everything is stored in the lazarette, ready to go as soon as you drop anchor, and all of it is included in the charter price.
        </p>
        <ul class="toy-list">
          {waterToys.map(toy => <li>{toy}</li>)}
        </ul>
        <h3 class="sub-heading">On Board</h3>
        <ul class="toy-list">
          {onBoard.map(item => <li>{item}</li>)}
        </ul>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box">
          <h3 class="sidebar-heading">Ready to Charter?</h3>
          <p class="sidebar-text">Check availability for a private day trip or overnight charter on the Galeon 500 Fly, departing from Royal Phuket Marina.</p>
          <a href="/contact" class="pcom-btn-primary">
            Inquire via Email
          </a>
        </div>
      </div>
    </section>

    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">Galeon 500 Fly Charter Rates 2026</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Rates are in Thai baht per charter, not per person, include 7% VAT and apply throughout the year. US dollar amounts are indicative (THB 33 = USD 1); charters are contracted and paid in Thai baht, subject to availability and confirmation at the time of booking.</p>
        <div class="heading-line"></div>
      </div>
      
      <div class="pcom-cabins-list">
        {cabins.map((cabin) => (
          <div class="cabin-rate-card">
            <div class="cabin-main-info">
              <h3 class="cabin-name">{cabin.name}</h3>
              <span class="cabin-location">{cabin.location}</span>
              <p class="cabin-details">{cabin.details}</p>
              <span class="cabin-trip-tag">{cabin.trip}</span>
            </div>
            <div class="cabin-price-zone">
              <span class="price-amount">{cabin.price}</span>
              <span class="price-label">{cabin.usd}</span>
              <span class="price-label">Per charter, 7% VAT incl.</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            What's Included
          </h3>
          <ul class="details-list">
            {includedItems.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Optional Upgrades & Fees
          </h3>
          <ul class="details-list">
            {notIncludedItems.map((item) => (
              <li class="details-item exc-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <div class="exc-text-wrapper">
                  <span class="exc-main-text">{item.text}</span>
                  {item.highlight && <span class="exc-highlight">{item.highlight}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Distances from Royal Phuket Marina</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Times are at 20 knots in settled conditions and exclude national park formalities. Day charters run eight hours from the marina.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Destination</th>
              <th>Distance</th>
              <th>Cruising Time</th>
            </tr>
          </thead>
          <tbody>
            {cruisingDistances.map((row) => (
              <tr>
                <td class="td-dates">{row.destination}</td>
                <td class="td-itinerary"><span class="itinerary-text">{row.distance}</span></td>
                <td class="td-route">{row.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Charter Availability</h2>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Schedule</th>
              <th>Package</th>
              <th>Route / Destination</th>
              <th class="table-action-header">Action</th>
            </tr>
          </thead>
          <tbody>
            {schedule.map((row) => (
              <tr>
                <td class="td-dates">{row.dates}</td>
                <td class="td-itinerary">
                  <span class="itinerary-text">{row.itinerary}</span>
                  <span class="type-badge badge-similan">
                    {row.type}
                  </span>
                </td>
                <td class="td-route">{row.route}</td>
                <td class="td-action">
                  <a href={`https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20booking%20the%20Galeon%20500%20Fly%20Yacht.`} target="_blank" rel="noopener noreferrer" class="table-book-btn">
                    Book
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>


    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Galeon 500 Fly Charter: Frequently Asked Questions</h2>
        <div class="heading-line"></div>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">{item.q}</summary>
            <p class="paragraph faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <a 
      href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20booking%20the%20Galeon%20500%20Fly%20Yacht." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="pcom-whatsapp-float"
      aria-label="Chat on WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

  </main>
</Layout>

<script>
  const slider = document.getElementById('slider') as HTMLDivElement | null;
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement | null;

  if (slider && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft + slideWidth >= slider.scrollWidth - 5) {
        slider.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: slideWidth, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft <= 0) {
        slider.scrollTo({ left: slider.scrollWidth, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: -slideWidth, behavior: 'smooth' });
      }
    });
  }
</script>

<style>
  :root {
    --pcom-font: "Next", "Arial Narrow", Arial, sans-serif;
    --pcom-color-canvas: #fff;
    --pcom-color-primary: #010205;
    --pcom-color-surface: #f1f1f4;
    --pcom-color-accent: #008EA7;
    --pcom-color-danger: #b31010;
    --pcom-color-text-muted: #4f5059;
    
    --pcom-space-md: clamp(16px, 1.25vw + 12px, 36px);
