    allYearUSD: 'USD 6,100',
    peakTHB: '231,000 ฿',
    peakUSD: 'USD 7,000',
    details: 'Kai & Naka Islands, Phang Nga Bay, Koh Maiton & Koh Kai, or Koh Hong (Krabi). Full day.'
  }
