const overnightRates = [
  { duration: '2 days / 1 night', allYearTHB: '228,000 ฿', allYearUSD: '6,900', peakTHB: '267,000 ฿', peakUSD: '8,100', similanTHB: '—', similanUSD: '—' },
  { duration: '3 days / 2 nights', allYearTHB: '454,000 ฿', allYearUSD: '13,750', peakTHB: '530,500 ฿', peakUSD: '16,100', similanTHB: '—', similanUSD: '—' },
