const notIncludedItems = [
  { text: 'Wine, champagne and spirits', highlight: 'Available on request' },
  { text: 'Similan national park fees', highlight: 'Not included' },
  { text: 'Activities or services on request', highlight: 'Supplement' },
  { text: 'Crew gratuities', highlight: 'Discretionary' }
