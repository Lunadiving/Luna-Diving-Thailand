---
import OptimizedImage from '../../components/OptimizedImage.astro';
import Layout from '../../layouts/Layout.astro';

const vesselName = "JAWSSS · Activa 5800";
const tagline = "An 18.6m Activa 5800 flybridge motor yacht for private day trips and overnight charters from Royal Phuket Marina";

const slideshow = [
  {
    img: "/images/yacht/jawsss/luxury-motor-yacht-jawsss-phuket.webp",
    alt: "Luxury motor yacht Jawsss cruising in Phuket, Thailand"
  },
  {
    img: "/images/yacht/jawsss/jawsss-yacht-aft-deck-tender.webp",
    alt: "Aft deck and tender boat of yacht Jawsss on charter in Phuket"
  },
  {
    img: "/images/yacht/jawsss/jawsss-cockpit-seating-thailand.webp",
    alt: "Rear cockpit seating area and Thai flag on yacht Jawsss in Phuket"
  },
  {
    img: "/images/yacht/jawsss/jawsss-yacht-main-saloon-interior.webp",
    alt: "Spacious luxury saloon interior with comfortable seating on yacht Jawsss"
  },
  {
    img: "/images/yacht/jawsss/jawsss-yacht-galley-kitchen-bar.webp",
    alt: "Fully equipped galley kitchen and bar area inside motor yacht Jawsss"
  },
  {
    img: "/images/yacht/jawsss/jawsss-bow-sun-deck-anchor.webp",
    alt: "Bow sun deck and anchor winch on luxury charter yacht Jawsss"
  },
  {
    img: "/images/yacht/jawsss/jawsss-master-cabin-double-bed.webp",
    alt: "Master cabin double bed with elegant towel art on yacht Jawsss"
  },
  {
    img: "/images/yacht/jawsss/jawsss-main-deck-outdoor-lounge.webp",
    alt: "Outdoor shaded dining and lounge area on the main deck of yacht Jawsss"
  },
  {
    img: "/images/yacht/jawsss/jawsss-yacht-vip-cabin-double-bed.webp",
    alt: "Forward guest cabin on motor yacht JAWSSS with a double berth accessible from both sides"
  },
  {
    img: "/images/yacht/jawsss/jawsss-yacht-twin-guest-cabin.webp",
    alt: "Twin guest cabin with two single beds on motor yacht Jawsss"
  }
];

const technicalSpecs = [
  { label: 'Builder & Model', value: 'Activa 5800' },
  { label: 'Type', value: 'Flybridge Motor Yacht' },
  { label: 'Year / Refit', value: '2013 / 2021' },
  { label: 'Length Overall', value: '18.60 m / 61 ft' },
  { label: 'Beam', value: '5.80 m' },
  { label: 'Engines', value: '2 x John Deere D-12, 775 hp Each' },
  { label: 'Cruising / Max Speed', value: '12 / 15 Knots' },
  { label: 'Fuel / Water', value: '3,500 L / 1,000 L' },
  { label: 'Guests', value: '12 Day / 6 Overnight' },
  { label: 'Cabins / Berths', value: '3 Cabins / 6 Berths' },
  { label: 'Bathrooms', value: '2' },
  { label: 'Crew', value: '3 (Skipper, Deckhand, Hostess)' },
  { label: 'Air Conditioning', value: 'Throughout' },
  { label: 'Home Port', value: 'Royal Phuket Marina' }
];

// Tariffe 2026 per charter (USD indicativi a 33 THB)
const dayRates = [
  { destination: 'Kai Nok, Khai Nak and Naka', low: 'THB 94,400', lowUsd: 'USD 2,860', high: 'THB 99,700', highUsd: 'USD 3,020' },
  { destination: 'Phang Nga Bay', low: 'THB 99,700', lowUsd: 'USD 3,020', high: 'THB 104,900', highUsd: 'USD 3,180' },
  { destination: 'Koh Maiton and Koh Kai', low: 'THB 104,900', lowUsd: 'USD 3,180', high: 'THB 110,200', highUsd: 'USD 3,340' },
  { destination: 'Koh Hong, Krabi', low: 'THB 104,900', lowUsd: 'USD 3,180', high: 'THB 110,200', highUsd: 'USD 3,340' }
];

const overnightRates = [
  { duration: '2 days, 1 night', low: 'THB 188,000', lowUsd: 'USD 5,700', high: 'THB 205,000', highUsd: 'USD 6,210', similan: '—', similanUsd: '' },
  { duration: '3 days, 2 nights', low: 'THB 280,400', lowUsd: 'USD 8,500', high: 'THB 306,600', highUsd: 'USD 9,290', similan: '—', similanUsd: '' },
  { duration: '4 days, 3 nights', low: 'THB 373,800', lowUsd: 'USD 11,330', high: 'THB 407,400', highUsd: 'USD 12,350', similan: 'THB 459,900', similanUsd: 'USD 13,940' },
  { duration: '5 days, 4 nights', low: 'THB 467,300', lowUsd: 'USD 14,160', high: 'THB 498,800', highUsd: 'USD 15,120', similan: 'THB 551,300', similanUsd: 'USD 16,710' },
  { duration: '6 days, 5 nights', low: 'THB 556,500', lowUsd: 'USD 16,860', high: 'THB 593,300', highUsd: 'USD 17,980', similan: 'THB 645,800', similanUsd: 'USD 19,570' },
  { duration: '7 days, 6 nights', low: 'THB 640,500', lowUsd: 'USD 19,410', high: 'THB 661,500', highUsd: 'USD 20,050', similan: 'THB 714,000', similanUsd: 'USD 21,640' }
];

const includedItems = [
  'Yacht with crew: skipper, deckhand and hostess',
  'Day charter 8 hours (09:00–17:00 or 10:00–18:00) / Overnight check-in 10:00, check-out 17:00',
  'Gourmet lunch on board for day charters / Full board for overnight charters',
  'Fruit, drinking water, soft drinks, local beer, and a bottle of wine',
  'Welcome package: fruit plate and fresh towels',
  'Water toys: snorkelling equipment, paddleboard, and kayak',
  'Yacht insurance, travel insurance, and local VAT'
];

const notIncludedItems = [
  'Alcoholic beverages beyond the included beer and wine',
  'Special catering, therapist, massage, photographer',
  'National park fees where applicable',
  'Cancellation and curtailment insurance',
  'Charterer liability insurance',
  'Crew gratuities (at charterer\'s discretion)',
  'Shuttle to and from accommodation (THB 3,210 / USD 97)'
];

const cruisingGrounds = [
  { name: 'Kai Nok, Khai Nak and Naka', type: 'Day charter' },
  { name: 'Phang Nga Bay', type: 'Day charter' },
  { name: 'Koh Maiton and Koh Kai', type: 'Day charter' },
  { name: 'Koh Hong, Krabi', type: 'Day charter' },
  { name: 'Similan Islands', type: 'From 4 days · Supplement' }
];

const waterToys = [
  "Snorkelling equipment",
  "Stand-up paddleboard",
  "Kayak",
  "Tender with outboard"
];

const onBoard = [
  "Air conditioning throughout",
  "CO2 detector in every cabin",
  "Saloon entertainment system and bar",
  "Welcome fruit plate and fresh towels"
];

const faqs = [
  {
    q: 'How much does a JAWSSS day charter cost?',
    a: 'An 8-hour private day charter costs from THB 94,400 (about USD 2,860) from May to November and from THB 99,700 (about USD 3,020) from December to April, depending on the destination. The rate covers up to 8 guests; additional guests are THB 2,000 (USD 60) each, up to 12.'
  },
  {
    q: 'How many guests can come on board?',
    a: 'Up to 12 guests on a day charter and up to 6 guests overnight, in three air-conditioned cabins with two bathrooms. JAWSSS is run by a crew of three: skipper, deckhand and hostess.'
  },
  {
    q: 'Where does the yacht depart from and at what time?',
    a: 'JAWSSS is based at Royal Phuket Marina. Day charters run for eight hours, from 09:00 to 17:00 or 10:00 to 18:00. Overnight charters check in at 10:00 on the first day and check out at 17:00 on the last. A shuttle from your accommodation is available for THB 3,210 (USD 97).'
  },
  {
    q: 'Which islands can we visit on a day trip?',
    a: 'Day charters go to Kai Nok, Khai Nak and Naka, Phang Nga Bay, Koh Maiton and Koh Kai, or Koh Hong in Krabi. Itineraries are planned around the guests rather than a fixed route.'
  },
  {
    q: 'Can we go to the Similan Islands?',
    a: 'Yes, on overnight charters of four days or more at the Similan rate, from THB 459,900 (about USD 13,940) for 4 days and 3 nights. Similan national park fees are not included.'
  },
  {
    q: 'What is included in the price?',
    a: 'The yacht with crew, a gourmet lunch on day charters or full board overnight, fruit, drinking water, soft drinks, local beer, a bottle of wine, a welcome fruit plate, fresh towels, snorkelling gear, paddleboard, kayak, tender, yacht and travel insurance and local VAT.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---

<Layout
  title="JAWSSS Yacht Charter Phuket | Activa 5800 Flybridge"
  description="Private yacht charter in Phuket on JAWSSS, an 18.6m Activa 5800 flybridge: day trips for 12 guests from THB 94,400, overnight for 6, Phang Nga Bay and Similans."
  image="/images/yacht/jawsss/luxury-motor-yacht-jawsss-phuket.webp"
>
  <main class="pcom-wrapper">
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">Activa 5800 · 18.6m Flybridge Motor Yacht</span>
      <h1 class="pcom-title">JAWSSS Yacht Charter Phuket</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <OptimizedImage 
                src={slide.img} 
                alt={`${vesselName} - ${slide.alt}`}
                loading="lazy"
                widths={[480, 800, 1200]}
                sizes="(max-width: 1200px) 100vw, 1200px"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.alt}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">Private Yacht Charter in Phuket on JAWSSS</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          <strong>JAWSSS</strong> is an <strong>Activa 5800 flybridge motor yacht</strong> of 18.6 metres, based at <strong>Royal Phuket Marina</strong>. She is available all year for <strong>private day trips for up to 12 guests</strong> and <strong>overnight charters for up to 6 guests</strong>, with a crew of three, and reaches the limestone islands of Phang Nga Bay well before lunch. With her fuel range, multi-day trips to the Similan Islands are also possible.
        </p>
        <p class="paragraph">
          Built in 2013 and refitted in 2021, she offers the comfort of a full flybridge cruiser in a size that stays easy to handle and to berth: a full-width saloon, a covered aft deck and a flybridge that remains pleasant even in the midday sun.
        </p>

        <h3 class="sub-heading">Fine Teak Joinery and Elegant Interiors</h3>
        <p class="paragraph">
          Teak is used generously both on deck and below, and the joinery is of the highest standard. Look closer and you will find paua shell inlays on the counter tops, cherry wood in the saloon and a built-in settee upholstered in leather, details that show how carefully she was finished.
        </p>

        <h3 class="sub-heading">Twin John Deere Engines and Long Range</h3>
        <p class="paragraph">
          Two John Deere D-12 diesel engines of 775 hp each give JAWSSS a comfortable cruising speed of 12 knots and a top speed of 15 knots. With 3,500 litres of fuel and 1,000 litres of fresh water on board, four- and five-day itineraries in the Andaman Sea are easy to plan.
        </p>

        <h3 class="sub-heading">A Shaded Flybridge for the Whole Group</h3>
        <p class="paragraph">
          The flybridge is shaded from end to end and is where most of a day charter is spent, with a dining table, seating for everyone on board and a second helm station. The upper helm sits forward with a clear view over the bow, so guests enjoy the sea breeze outside while the saloon below stays air-conditioned.
        </p>

        <h3 class="sub-heading">Aft Deck, Swim Platform and Bow Sun Pad</h3>
        <p class="paragraph">
          Directly off the saloon, the teak aft deck has a shaded table for six. The low, wide swim platform makes it simple to get on board, go swimming or launch the tender, while at the bow a sun pad stretches across the full width of the foredeck.
        </p>

        <h3 class="sub-heading">Air-Conditioned Saloon and Galley</h3>
        <p class="paragraph">
          The full-beam saloon is air-conditioned and softly lit, with a cream leather settee wrapped around an inlaid cherry wood table that adjusts from coffee to dining height. A bar and an entertainment system sit in one corner. The galley is just forward, at the top of the companionway, so the hostess can prepare meals without being cut off from the guests. Day charters include a gourmet lunch and overnight charters are full board, all cooked on board.
        </p>

        <h3 class="sub-heading">Three Cabins and Two Bathrooms</h3>
        <p class="paragraph">
          The full-beam master cabin sits amidships with a king-size berth placed across the yacht and its own en-suite bathroom. The forward cabin has a double berth that can be reached from both sides, and the twin cabin on the port side has two single berths. A second bathroom with a separate shower serves the guest cabins, and every cabin is air-conditioned and fitted with a CO2 detector.
        </p>

        <h3 class="sub-heading">Water Toys and Amenities</h3>
        <ul class="toy-list">
          {waterToys.map(toy => <li>{toy}</li>)}
        </ul>
        <ul class="toy-list">
          {onBoard.map(item => <li>{item}</li>)}
        </ul>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box">
          <h3 class="sidebar-heading">Ready to Charter JAWSSS?</h3>
          <p class="sidebar-text">Check availability for a private day trip or a multi-day island charter on JAWSSS, departing from Royal Phuket Marina.</p>
          <a href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20booking%20JAWSSS%20Activa%205800." target="_blank" rel="noopener noreferrer" class="pcom-btn-primary">
            Book via WhatsApp
          </a>
        </div>
      </div>
    </section>

    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">JAWSSS Day Charter Rates 2026</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Eight hours on board (09:00 to 17:00 or 10:00 to 18:00) for up to twelve guests. Rates are per charter for up to 8 guests; additional guests are THB 2,000 (USD 60) per person, up to a maximum of 12. US dollar amounts are indicative (THB 33 = USD 1); charters are quoted and paid in Thai Baht.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Destination</th>
              <th>May – Nov</th>
              <th>Dec – April</th>
            </tr>
          </thead>
          <tbody>
            {dayRates.map((row) => (
              <tr>
                <td class="td-dates">{row.destination}</td>
                <td class="td-itinerary"><span class="itinerary-text">{row.low}</span><div class="td-route">{row.lowUsd}</div></td>
                <td class="td-itinerary"><span class="itinerary-text">{row.high}</span><div class="td-route">{row.highUsd}</div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">JAWSSS Overnight Charter Rates 2026</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Check-in at 10:00 on day one, check-out at 17:00 on final day. Sleeps up to 6 guests in 3 cabins. Similan Islands itineraries are available from four days at the Similan rate; national park fees are not included.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Duration</th>
              <th>May – Nov</th>
              <th>Dec – April</th>
              <th>Similan Islands</th>
            </tr>
          </thead>
          <tbody>
            {overnightRates.map((row) => (
              <tr>
                <td class="td-dates">{row.duration}</td>
                <td class="td-itinerary"><span class="itinerary-text">{row.low}</span><div class="td-route">{row.lowUsd}</div></td>
                <td class="td-itinerary"><span class="itinerary-text">{row.high}</span><div class="td-route">{row.highUsd}</div></td>
                <td class="td-itinerary"><span class="itinerary-text"><strong>{row.similan}</strong></span><div class="td-route">{row.similanUsd}</div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Cruising Grounds in the Andaman Sea</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Itineraries are planned around the guests rather than a fixed route. National park fees apply at some destinations, and running times are confirmed at the time of booking.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Destination / Ground</th>
              <th>Program Type</th>
            </tr>
          </thead>
          <tbody>
            {cruisingGrounds.map((ground) => (
              <tr>
                <td class="td-dates">{ground.name}</td>
                <td class="td-itinerary"><span class="type-badge badge-similan">{ground.type}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            What's Included
          </h3>
          <ul class="details-list">
            {includedItems.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Not Included
          </h3>
          <ul class="details-list">
            {notIncludedItems.map((item) => (
              <li class="details-item exc-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <div class="exc-text-wrapper">
                  <span class="exc-main-text">{item}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">JAWSSS Charter: Frequently Asked Questions</h2>
        <div class="heading-line"></div>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">{item.q}</summary>
            <p class="paragraph faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <a 
      href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20booking%20JAWSSS%20Activa%205800." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="pcom-whatsapp-float"
      aria-label="Chat on WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

  </main>
</Layout>

<script>
  const slider = document.getElementById('slider') as HTMLDivElement | null;
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement | null;

  if (slider && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft + slideWidth >= slider.scrollWidth - 5) {
        slider.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: slideWidth, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft <= 0) {
        slider.scrollTo({ left: slider.scrollWidth, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: -slideWidth, behavior: 'smooth' });
      }
    });
  }
</script>

<style>
  :root {
    --pcom-font: "Next", "Arial Narrow", Arial, sans-serif;
    --pcom-color-canvas: #fff;
