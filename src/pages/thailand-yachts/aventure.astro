---
import OptimizedImage from '../../components/OptimizedImage.astro';
// src/pages/thailand-yachts/aventure.astro
import Layout from '../../layouts/Layout.astro';

const vesselName = "Aventure";
const tagline = "A 29m classic ketch for private sailing charters in the Andaman Sea and expeditions to the Mergui Archipelago";

const slideshow = [
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-under-full-sail.webp', 
    text: 'Classic sailing yacht Aventure heeling under full sail through the open waters of the Andaman Sea.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-luxury-sailing-yacht-sunset.webp', 
    text: 'Aventure at anchor beneath a vivid purple and orange sunset, framed by limestone islands.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-stern-view.webp', 
    text: 'Elegant white stern of Aventure with her name in gold script, crew at the wheel under the shaded deck.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-sailing-stern-view.webp', 
    text: 'Guests and crew enjoying the sail on the aft deck as Aventure cruises with all sails set.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-wooden-deck-view.webp', 
    text: 'View along the varnished teak deck and mast, with shade awnings open over the guest lounge areas.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-deck-helm.webp', 
    text: 'Classic wooden steering wheel and helm station on the shaded aft deck, overlooking a tropical island.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-classic-compass.webp', 
    text: 'Brass-ringed Ritchie compass engraved with the Aventure name, set in a polished teak binnacle.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-outdoor-dining.webp', 
    text: 'Outdoor dining table on deck set for a fresh seafood lunch with lobster, crab and sea views.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-interior-salon.webp', 
    text: 'Bright interior salon with teak floors, colonial-style armchairs, skylights and a dining table.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-navigation-station.webp', 
    text: 'Teak navigation station with chart desk, compass rose inlay and onboard electronics.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-master-cabin.webp', 
    text: 'Master cabin with double berth beneath opening skylights, polished teak joinery and fresh orchids.' 
  },
  { 
    img: '/images/yacht/aventure/aventure-sailing-yacht-guest-cabin.webp', 
    text: 'Guest cabin with double bed, teak finishes and a private en-suite bathroom with shower.' 
  }
];

const technicalSpecs = [
  { label: 'Builder', value: 'Patrick Balta, Thailand' },
  { label: 'Year', value: '2011, freshly renovated' },
  { label: 'Type', value: 'Classic Ketch' },
  { label: 'Length Overall', value: '29 m / 95 ft' },
  { label: 'Beam / Draft', value: '6.1 m / 3.1 m' },
  { label: 'Engine', value: '1 x 400 hp MAN' },
  { label: 'Cruising Speed', value: '8 Knots' },
  { label: 'Guests', value: '7 Overnight' },
  { label: 'Cabins', value: '3 Double, 1 Single' },
  { label: 'Crew', value: '4' },
  { label: 'Fuel / Water', value: '6,500 L / 1,000 L' },
  { label: 'Cruising Grounds', value: 'Thailand & Myanmar (Mergui)' },
  { label: 'Home Port', value: 'Yacht Haven Marina, Phuket' }
];

// Tariffe 2026 per charter (non a persona), valide tutto l'anno
const rates = [
  { duration: '2 Days / 1 Night', thb: '290,000', usd: '8,910' },
  { duration: '3 Days / 2 Nights', thb: '430,000', usd: '13,230' },
  { duration: '4 Days / 3 Nights', thb: '567,000', usd: '17,460' },
  { duration: '5 Days / 4 Nights', thb: '702,000', usd: '21,600' },
  { duration: '6 Days / 5 Nights', thb: '834,000', usd: '25,650' },
  { duration: '7 Days / 6 Nights', thb: '962,000', usd: '29,610' },
  { duration: '8 Days / 7 Nights', thb: '1,088,000', usd: '33,480' }
];

const includedItems = [
  'Yacht with a crew of four, including cook',
  'Check-in from 10:00, check-out after sunset on the final day',
  'Full board: gourmet meals and snacks, fruit, drinking water, tea, coffee, soft drinks & local beers',
  'House wines',
  'Return transfers from the airport or any hotel in Phuket',
  'Embarkation at Yacht Haven, or at Koh Rang Yai from Royal Phuket Marina',
  'Cruising the southern and northern Andaman Sea',
  'Fishing tackle, kayak, two stand-up paddleboards, snorkelling gear & diving equipment',
  'National park fees, cleaning & yacht insurance',
  'All applicable taxes and local VAT'
];

const notIncludedItems = [
  { text: 'Scuba Diving Master Instructor', highlight: 'On request' },
  { text: 'Fine Wines, Champagne & Spirits', highlight: 'On request' },
  { text: 'Crew Gratuities', highlight: "At the guests' discretion" },
  { text: 'Myanmar Cross-Border Relocation & Administration Fee', highlight: 'USD 6,000' },
  { text: 'Myanmar Cruising Permits & Clearance', highlight: 'Supplement' },
  { text: 'Any Other Requested Activities or Services', highlight: 'On request' }
];

const schedule = [
  { dates: "All Year", itinerary: "Andaman Sea Overnight (7 Guests)", route: "Southern & Northern Andaman Sea from Phuket", type: "Overnight" },
  { dates: "November to April", itinerary: "Mergui Archipelago Expedition", route: "Similans / Surin / Kawthaung / Lampi / Northern Groups", type: "Expedition" }
];

// Rotta verso nord dalla brochure; tempi indicativi a 8 nodi
const cruisingDistances = [
  { destination: "Phuket to the Similan Islands", distance: "55 nm", time: "Approx. 7 hours" },
  { destination: "Similan to the Surin Islands", distance: "45 nm", time: "Approx. 5 h 40 min" },
  { destination: "Surin to Kawthaung, Myanmar", distance: "60 nm", time: "Approx. 7 h 30 min" },
  { destination: "Kawthaung to Lampi Island", distance: "45 nm", time: "Approx. 5 h 40 min" },
  { destination: "On into the northern groups", distance: "120 nm", time: "Approx. 15 hours" }
];

const waterToys = [
  "Tender with outboard motor",
  "Kayak",
  "2 Stand-up paddleboards (SUP)",
  "Snorkelling equipment",
  "Diving equipment & Bauer Junior air compressor",
  "Fishing rods & tackle"
];

const faqs = [
  {
    q: 'How many guests can sleep aboard Aventure?',
    a: 'Aventure takes up to 7 guests overnight in three double cabins and one single cabin, each with its own bathroom. She sails with a crew of four, including a cook. Day charter capacity is confirmed at the time of enquiry.'
  },
  {
    q: 'Where does the charter start?',
    a: 'Charters start at Yacht Haven Marina in the north of Phuket, or at Koh Rang Yai with a transfer from Royal Phuket Marina. Return transfers from Phuket airport or any hotel in Phuket are included.'
  },
  {
    q: 'How much does it cost to charter Aventure?',
    a: 'Overnight charters start from THB 290,000 (about USD 8,910) for 2 days and 1 night, up to THB 1,088,000 (about USD 33,480) for 8 days and 7 nights. Rates are per charter, not per person, apply all year and include taxes and local VAT. Longer charters are available on request.'
  },
  {
    q: 'Can we sail to the Mergui Archipelago in Myanmar?',
    a: 'Yes. The best season is November to April, and we suggest a charter of at least 7 nights. Cross-border charters carry an extra relocation and administration fee of USD 6,000, and Myanmar cruising permits and clearance are arranged in advance as a supplement.'
  },
  {
    q: 'Can we go scuba diving from Aventure?',
    a: 'Yes. Diving equipment and a Bauer Junior air compressor are carried on board. A scuba diving instructor or certified dive guide can join the charter at an additional cost.'
  },
  {
    q: 'What is included in the charter price?',
    a: 'The yacht with a crew of four, full board with snacks, fruit, drinking water, tea, coffee, soft drinks, local beers and house wines, airport and hotel transfers, kayak, two paddleboards, snorkelling and diving equipment, fishing tackle, national park fees, cleaning, insurance, taxes and VAT. Fine wines, champagne, spirits, the dive instructor and crew gratuities are extra.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const whatsappUrl = `https://wa.me/66918233120?text=${encodeURIComponent("Hi Luna Diving! I'm interested in chartering the classic ketch Aventure.")}`;
---

<Layout
  title={`${vesselName} Sailing Yacht Charter Phuket | 29m Classic Ketch`}
  description="Private sailing yacht charter from Phuket on Aventure, a 29m classic ketch for 7 guests: Andaman Sea cruises, Mergui expeditions and diving gear aboard."
  image="/images/yacht/aventure/aventure-sailing-yacht-under-full-sail.webp"
>
  <main class="pcom-wrapper">
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">Classic 29m Ketch</span>
      <h1 class="pcom-title">{vesselName} Sailing Yacht Charter Phuket</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <OptimizedImage 
                src={slide.img} 
                alt={`${vesselName} - ${slide.text}`}
                loading="lazy"
                widths={[480, 800, 1200]}
                sizes="(max-width: 1200px) 100vw, 1200px"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.text}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">Private Sailing Yacht Charter from Phuket</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          <strong>Aventure</strong> is a <strong>29-metre (95 ft) classic ketch</strong> available for <strong>private sailing charters from Phuket</strong>. With room for <strong>7 guests in four cabins</strong> and a crew of four, she sails all year across the Andaman Sea, from Phang Nga Bay to the Similan and Surin Islands, and from November to April she makes the longer voyage north to the remote <strong>Mergui Archipelago</strong> in Myanmar.
        </p>
        <p class="paragraph">
          Recently renovated, she combines the look and feel of a traditional sailing yacht, with two masts, varnished teak and long, elegant overhangs, with the space, comfort and full board service of a private charter yacht.
        </p>

        <h3 class="sub-heading">Built by Patrick Balta in 2011</h3>
        <p class="paragraph">
          Aventure was launched in 2011 by Patrick Balta, a French shipwright whose yard in Thailand is known for some of the most beautiful traditional yachts sailing in Asian waters. Her raked transom, long overhangs and generous sail plan on two masts are the work of a builder who knows traditional yachts.
        </p>

        <h3 class="sub-heading">A True Sailing Yacht for the Andaman Sea</h3>
        <p class="paragraph">
          With her ketch rig and generous displacement, Aventure is a proper sea boat. When the wind drops, a single 400 hp MAN engine keeps her moving at a cruising speed of 8 knots, and with 6,500 litres of fuel and 1,000 litres of fresh water on board she has the range for multi-day passages far from the nearest marina.
        </p>

        <h3 class="sub-heading">Mergui Archipelago Sailing Expeditions</h3>
        <p class="paragraph">
          North of the Surin Islands, along the Tanintharyi coast of southern Myanmar, the Mergui Archipelago counts around eight hundred islands. Closed to foreign visitors for about fifty years, it is still one of the least visited cruising grounds in Asia: granite headlands, empty white beaches, Moken sea-nomad villages and reefs that day-trip boats never reach.
        </p>
        <p class="paragraph">
          The voyage from Phuket runs via the Similan and Surin Islands to Kawthaung, then on to Lampi Island and the northern island groups. The season runs from November to April, when the northeast monsoon opens the passage into Myanmar, and we recommend at least seven nights. Myanmar permits and border clearance are organised before departure.
        </p>

        <h3 class="sub-heading">Teak Decks and a Shaded Cockpit</h3>
        <p class="paragraph">
          Life on board happens outside. Wide side decks and a long, clear foredeck give plenty of room to sunbathe, while awnings provide shade wherever it is needed. Behind the mizzen mast, the cockpit around the wheel is the heart of the yacht: breakfast is served here, the fishing rods are kept here, and most guests spend their days here. At anchor a full awning covers the cockpit, and it is stowed when the wind picks up.
        </p>

        <h3 class="sub-heading">Saloon, Galley and Navigation</h3>
        <p class="paragraph">
          Below deck the atmosphere is calm and cool. The saloon spans the full width of the yacht, lit by skylights along the coachroof and finished in hardwood panelling with a varnished teak floor, a comfortable place to eat when the weather turns. The galley is equipped for a cook to prepare three meals a day for seven guests during long passages, and the chart table is staffed on every voyage.
        </p>

        <h3 class="sub-heading">Four Cabins for Seven Guests</h3>
        <p class="paragraph">
          Aventure has three double cabins and one single cabin, all panelled in hardwood and each with storage, reading lights and its own bathroom. The master cabin has a double berth under opening skylights, hanging lockers on both sides, drawers beneath the bed and a private en-suite bathroom. Fresh flowers, cotton linen and an evening turndown are part of the service.
        </p>

        <h3 class="sub-heading">Diving, Snorkelling and Water Toys</h3>
        <p class="paragraph">
          As a dive centre, we especially like that Aventure carries her own diving equipment and a Bauer Junior air compressor, so you can dive the Similans, the Surins or the untouched reefs of Mergui straight from the yacht. A scuba instructor or certified dive guide can join the charter at extra cost. Snorkelling gear, paddleboards and a kayak are included for everyone else.
        </p>
        <ul class="toy-list">
          {waterToys.map(toy => <li>{toy}</li>)}
        </ul>

        <h3 class="sub-heading">Photo, Fashion and Brand Shoots</h3>
        <p class="paragraph">
          Aventure is also chartered by fashion houses and luxury brands as a location for advertising campaigns and editorial photo shoots. Her rig, her teak and the light of the Andaman Sea are as much of a draw as the anchorages.
        </p>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box">
          <h3 class="sidebar-heading">Ready to Charter?</h3>
          <p class="sidebar-text">Check availability for a private sailing charter or a Mergui expedition on the 29m classic ketch Aventure, departing from Yacht Haven Marina, Phuket.</p>
          <a href="/contact?vessel=Aventure" class="pcom-btn-primary">
            Inquire via Email
          </a>
        </div>
      </div>
    </section>

    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">Charter Rates 2026</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Private overnight charter for up to 7 guests with a crew of 4. Rates are per charter, not per person, and apply all year. Longer charters on request; confirm the contract currency at the time of booking.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Duration</th>
              <th>Thai Baht</th>
              <th>US Dollar</th>
              <th class="table-action-header">Action</th>
            </tr>
          </thead>
          <tbody>
            {rates.map((row) => (
              <tr>
                <td class="td-dates">{row.duration}</td>
                <td class="td-itinerary"><span class="itinerary-text">THB {row.thb}</span></td>
                <td class="td-route">USD {row.usd}</td>
                <td class="td-action">
                  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="table-book-btn">
                    Book
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="paragraph" style="margin-top: 12px;">Cross-border charters to Myanmar carry an additional relocation and administration fee of USD 6,000.</p>
    </section>

    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            What's Included
          </h3>
          <ul class="details-list">
            {includedItems.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Optional Extras & Fees
          </h3>
          <ul class="details-list">
            {notIncludedItems.map((item) => (
              <li class="details-item exc-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <div class="exc-text-wrapper">
                  <span class="exc-main-text">{item.text}</span>
                  {item.highlight && <span class="exc-highlight">{item.highlight}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">The Passage North to Mergui</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Suggested charter: 7 nights or more, November to April. Distances are indicative, times are approximate at 8 knots, and the routing is built around the guests. Myanmar permits and clearances are arranged in advance.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Leg</th>
              <th>Distance</th>
              <th>Cruising Time</th>
            </tr>
          </thead>
          <tbody>
            {cruisingDistances.map((row) => (
              <tr>
                <td class="td-dates">{row.destination}</td>
                <td class="td-itinerary"><span class="itinerary-text">{row.distance}</span></td>
                <td class="td-route">{row.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Charter Availability</h2>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Schedule</th>
              <th>Package</th>
              <th>Route / Destination</th>
              <th class="table-action-header">Action</th>
            </tr>
          </thead>
          <tbody>
            {schedule.map((row) => (
              <tr>
                <td class="td-dates">{row.dates}</td>
                <td class="td-itinerary">
                  <span class="itinerary-text">{row.itinerary}</span>
                  <span class="type-badge badge-similan">
                    {row.type}
                  </span>
                </td>
                <td class="td-route">{row.route}</td>
                <td class="td-action">
                  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="table-book-btn">
                    Book
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Aventure Charter: Frequently Asked Questions</h2>
        <div class="heading-line"></div>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">{item.q}</summary>
            <p class="paragraph faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <a 
      href={whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="pcom-whatsapp-float"
      aria-label="Chat on WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

  </main>
</Layout>

<script>
  const slider = document.getElementById('slider');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  if (slider && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', () => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft + slideWidth >= slider.scrollWidth - 5) {
        slider.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: slideWidth, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', () => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft <= 0) {
        slider.scrollTo({ left: slider.scrollWidth, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: -slideWidth, behavior: 'smooth' });
