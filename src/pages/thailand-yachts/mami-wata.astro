    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Multi-day expedition with complete crew service, meals, and water toys.',
    trip: 'Overnight'
  },
  {
    name: 'Five Days / Four Nights',
    price: '400,000 ฿',
    usd: 'USD 12,150 (Dec-Apr: 415,000 ฿ / USD 12,600)',
    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Deep immersion charter along southern islands and secluded anchorages.',
    trip: 'Overnight'
  },
  {
    name: 'Six Days / Five Nights',
    price: '475,000 ฿',
    usd: 'USD 14,400 (Dec-Apr: 485,000 ฿ / USD 14,700)',
    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Full week island hopping program with custom routing.',
    trip: 'Overnight'
  },
  {
    name: 'Seven Days / Six Nights',
    price: '550,000 ฿',
    usd: 'USD 16,700 (Dec-Apr: 565,000 ฿ / USD 17,150)',
    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Ultimate week-long private charter experience in the Andaman Sea.',
    trip: 'Overnight'
  }
];

const includedItems = [
  'Whole vessel with crew of three: skipper, deckhand and hostess',
  'Day charter hours: 09:00 to 17:00, or 10:00 to 18:00',
  'Gourmet lunch on day charters, full board on overnight charters',
  'Fruit, drinking water, soft drinks, local beer and a bottle of wine',
  'Welcome package with fruit plate and fresh towels',
  'Snorkelling equipment, stand up paddleboard and kayak',
  'Yacht insurance, passenger insurance and local VAT'
];

const notIncludedItems = [
  { text: 'Alcoholic beverages beyond those listed', highlight: 'On request' },
  { text: 'Special catering, therapist, massage and photography', highlight: 'Supplement' },
  { text: 'National park fees where applicable', highlight: 'Direct payment' },
  { text: 'Cancellation, curtailment & liability insurance', highlight: 'Optional' },
  { text: 'Crew gratuities', highlight: 'Discretionary' }
];

// Durate dei charter dalla brochure (non tempi di navigazione)
const cruisingDistances = [
  { destination: "Sunset cruise, Phuket east coast", time: "3 hours" },
  { destination: "Rang Yai and Kai Islands", time: "5 hours" },
  { destination: "Phang Nga Bay", time: "8 hours" },
  { destination: "Krabi, Four Islands", time: "8 hours" },
  { destination: "Overnight itineraries", time: "2 to 7 days" }
];

// Riposizionamenti e transfer, listino 2026/27
const relocations = [
  { destination: "Shuttle to and from accommodation, return", thb: "THB 3,000", usd: "USD 95" },
  { destination: "Relocation to Koh Yao", thb: "THB 10,500", usd: "USD 320" },
  { destination: "Relocation to Ao Po Grand Marina", thb: "THB 10,500", usd: "USD 320" },
  { destination: "Relocation to Chalong Pier", thb: "THB 15,750", usd: "USD 480" },
  { destination: "Relocation to Krabi", thb: "THB 15,750", usd: "USD 480" }
];

const waterToys = [
  "Snorkelling equipment",
  "Stand-up paddleboard (SUP)",
  "Kayak",
  "Fishing rods",
  "Tender"
];

const onBoard = [
  "Sun parasols and beanbags",
  "Foredeck sunpads",
  "Welcome fruit and fresh towels",
  "Gourmet lunch on day charters, full board overnight",
  "Flowers, cake and celebrations (supplement)",
  "Photographer or massage therapist on board (supplement)"
];

const faqs = [
  {
    q: 'How much does a sunset cruise on Mami Wata cost?',
    a: 'A 3-hour private sunset cruise along the east coast of Phuket costs THB 41,000 (about USD 1,250) for up to 8 guests, and THB 52,000 (about USD 1,600) from 22 December to 5 January. Lunch is not included on the sunset cruise.'
  },
  {
    q: 'How much does a full-day charter cost?',
    a: 'An 8-hour day charter to Phang Nga Bay or the Four Islands of Krabi costs THB 83,000 (about USD 2,550) from May to November, THB 94,000 (about USD 2,850) from December to April and THB 104,000 (about USD 3,200) from 22 December to 5 January. Above 8 guests, each extra guest is THB 1,500 (USD 50), up to 12.'
  },
  {
    q: 'Can we organise a marriage proposal or honeymoon on board?',
    a: 'Yes. Mami Wata is popular for proposals, anniversaries and honeymoons. The crew can arrange flowers, a quiet anchorage, a photographer on board and dinner on the foredeck. Flowers, cake, celebrations and the photographer are available as supplements.'
  },
  {
    q: 'How many guests can come on board?',
    a: 'Up to 12 guests on a day charter and up to 6 guests overnight, in two cabins. The yacht is run by a crew of three: skipper, deckhand and a hostess who cooks on board.'
  },
  {
    q: 'Where does Mami Wata depart from?',
    a: 'Mami Wata is based at Royal Phuket Marina. She can also start from Koh Yao or Ao Po Grand Marina (THB 10,500 relocation) or from Chalong Pier or Krabi (THB 15,750). A return shuttle from your accommodation costs THB 3,000 (USD 95).'
  },
  {
    q: 'What is included in the price?',
    a: 'The whole yacht with crew, a gourmet lunch on day charters or full board overnight, fruit, drinking water, soft drinks, local beer, a bottle of wine, a welcome fruit plate and fresh towels, snorkelling gear, paddleboard and kayak, yacht and passenger insurance and local VAT.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---

<Layout
  title="Mami Wata Yacht Charter Phuket | Classic 1954 Halvorsen"
  description="Charter Mami Wata, a classic 1954 Halvorsen wooden yacht in Phuket: sunset cruises from THB 41,000, Phang Nga Bay day trips, proposals and honeymoons."
  image="/images/yacht/mami-wata/mami-wata-classic-motor-yacht-sunset-profile.webp"
>
  <main class="pcom-wrapper">
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">Classic 1954 Halvorsen Motor Yacht</span>
      <h1 class="pcom-title">{vesselName} Yacht Charter Phuket</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <OptimizedImage 
                src={slide.img} 
                alt={slide.text}
                loading="lazy"
                widths={[480, 800, 1200]}
                sizes="(max-width: 1200px) 100vw, 1200px"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.text}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">Classic Wooden Yacht Charter in Phuket</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          <strong>Mami Wata</strong> is a <strong>classic 1954 Halvorsen motor yacht</strong> of 15 metres, built in timber and based at <strong>Royal Phuket Marina</strong>. She is available for <strong>private sunset cruises</strong>, <strong>day trips for up to 12 guests</strong> to Phang Nga Bay and Krabi, and <strong>overnight charters for up to 6 guests</strong>, always with the whole yacht to yourselves and a crew of three.
        </p>
        <p class="paragraph">
          She is not built for speed, and that is her charm. Mami Wata leaves the marina in the morning, heads for a quiet anchorage away from the crowds and comes back at dusk, with warm teak underfoot and candles lit on deck.
        </p>

        <h3 class="sub-heading">A 1954 Halvorsen with a 2023 Refit</h3>
        <p class="paragraph">
          Mami Wata comes from the Halvorsen yard, a family of Norwegian boatbuilders whose timber motor cruisers shaped the look of Sydney Harbour for fifty years. Her planked hull, teak deck and varnished woodwork show their age with grace.
        </p>
        <p class="paragraph">
          A complete refit in 2023 brought her systems up to date, with twin Cummins diesels and renewed tanks, while keeping every detail of her character, including the buttoned leather banquette in the saloon and the original brass instruments on the bulkhead. The crew is made up of a skipper who knows this coast in every season, a deckhand and a hostess who cooks on board.
        </p>

        <h3 class="sub-heading">Relaxed Cruising at 8 to 12 Knots</h3>
        <p class="paragraph">
          Two 220 hp Cummins diesel engines give her a gentle cruising speed of 8 to 12 knots, ideal for the island waters east of Phuket. The Kai Islands are a short run from the marina and Phang Nga Bay is reached within the morning. At anchor she sits steady, so lunch on deck stays on the table.
        </p>

        <h3 class="sub-heading">A Teak Foredeck Made for Relaxing</h3>
        <p class="paragraph">
          The foredeck is her best feature: open teak with four director's chairs, two long sunpads and enough space for eight people to spread out. Parasols come up when the sun gets strong, and after lunch the beanbags come out. At the outside steering position, with its spoked wheel and original instruments, guests are welcome to take the helm with the skipper close by.
        </p>

        <h3 class="sub-heading">Vintage Saloon and Two Cabins</h3>
        <p class="paragraph">
          Below deck, the saloon combines dark timber, buttoned leather and white cotton: cool in the middle of the day and the cosiest place on board in the evening, with fresh orchids on every charter. The two forward cabins are lined in timber, with natural light, opening portholes and storage under the berths, and are turned down before dinner with fresh towels twice a day.
        </p>

        <h3 class="sub-heading">Lunch Cooked on Board</h3>
        <p class="paragraph">
          The hostess cooks every meal on board and serves it wherever you like: on the foredeck under the parasols, in the shade of the saloon or on the aft deck at anchor. Choose Thai or Western dishes, and the crew will shop for anything you request. Bringing your own champagne? It will be chilled and waiting.
        </p>

        <h3 class="sub-heading">Proposals, Honeymoons and Romantic Cruises</h3>
        <p class="paragraph">
          Mami Wata can take a group of friends to the beach for the day, but she is just as special with only two people on board. For a <strong>marriage proposal on a yacht in Phuket</strong>, an anniversary or a honeymoon, the day is planned around your moment: fresh flowers from the morning market, a secluded anchorage, a photographer if you want to capture it and a candlelit dinner on the way back.
        </p>
        <p class="paragraph">
          The crew prepares dinner on the foredeck while you swim, then discreetly steps away. More than one proposal has already been made on this deck.
        </p>

        <h3 class="sub-heading">Water Toys and Amenities</h3>
        <ul class="toy-list">
          {waterToys.map(toy => <li>{toy}</li>)}
        </ul>
        <ul class="toy-list">
          {onBoard.map(item => <li>{item}</li>)}
        </ul>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box">
          <h3 class="sidebar-heading">Inquire for Mami Wata</h3>
          <p class="sidebar-text">Check availability for a sunset cruise, a private day trip or a romantic overnight charter on the classic 1954 Halvorsen Mami Wata, from Royal Phuket Marina.</p>
          <a href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20chartering%20Mami%20Wata." target="_blank" rel="noopener noreferrer" class="pcom-btn-primary">
            Inquire via WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Day Charter Pricing Section -->
    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">Mami Wata Day Charter Rates 2026/27</h2>
        <p class="paragraph" style="margin-bottom: 8px;">Per charter for the whole yacht, up to 8 guests, local VAT included. US dollar amounts are indicative (THB 33 = USD 1); charters are contracted and invoiced in Thai baht.</p>
        <div class="heading-line"></div>
      </div>
      
      <div class="pcom-cabins-list">
        {dayCharterRates.map((rate) => (
          <div class="cabin-rate-card">
            <div class="cabin-main-info">
              <h3 class="cabin-name">{rate.name}</h3>
              <span class="cabin-location">{rate.location}</span>
              <p class="cabin-details">{rate.details}</p>
              <span class="cabin-trip-tag">{rate.trip}</span>
            </div>
            <div class="cabin-price-zone">
              <span class="price-amount">{rate.price}</span>
              <span class="price-label">{rate.usd}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="table-note-text" style="margin-top: 16px;">
        * Above eight guests, THB 1,500 (USD 50) per person for full day charters and THB 750 (USD 25) per person for half day charters.<br/>
        * Lunch is not included on the sunset cruise.
      </p>
    </section>

    <!-- Overnight Charter Pricing Section -->
    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">Mami Wata Overnight Charter Rates 2026/27</h2>
        <p class="paragraph" style="margin-bottom: 8px;">Per charter, up to 6 guests in 2 cabins. Main price May to November; December to April rate shown below it. The crew live aboard on overnight charters.</p>
        <div class="heading-line"></div>
      </div>
      
      <div class="pcom-cabins-list">
        {overnightRates.map((rate) => (
          <div class="cabin-rate-card">
            <div class="cabin-main-info">
              <h3 class="cabin-name">{rate.name}</h3>
              <span class="cabin-location">{rate.location}</span>
              <p class="cabin-details">{rate.details}</p>
              <span class="cabin-trip-tag">{rate.trip}</span>
            </div>
            <div class="cabin-price-zone">
              <span class="price-amount">{rate.price}</span>
              <span class="price-label">{rate.usd}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="table-note-text" style="margin-top: 16px;">
        * Overnight charters embark at 10:00 and disembark at 18:30 on the final day.
      </p>
    </section>

    <!-- Inclusions & Exclusions -->
    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            What the Rate Covers
          </h3>
          <ul class="details-list">
            {includedItems.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Not Included
          </h3>
          <ul class="details-list">
            {notIncludedItems.map((item) => (
              <li class="details-item exc-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <div class="exc-text-wrapper">
                  <span class="exc-main-text">{item.text}</span>
                  {item.highlight && <span class="exc-highlight">{item.highlight}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Cruising Grounds Table -->
    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Cruising Grounds from Royal Phuket Marina</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Mami Wata charters by the day or by the week along the Andaman coast. Durations below are charter lengths from the marina; passage times vary with sea state and season, and itineraries remain subject to weather and harbour clearance.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Charter</th>
              <th>Duration</th>
            </tr>
          </thead>
          <tbody>
            {cruisingDistances.map((row) => (
              <tr>
                <td class="td-dates">{row.destination}</td>
                <td class="td-route">{row.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Relocation and Transfers</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Start or finish your charter away from Royal Phuket Marina, or add a return shuttle from your accommodation.</p>
        <div class="heading-line"></div>
      </div>
      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
