---
import OptimizedImage from '../../components/OptimizedImage.astro';
// src/pages/thailand-yachts/mami-wata.astro
import Layout from '../../layouts/Layout.astro';

const vesselName = "Mami Wata";
const tagline = "A classic 1954 Halvorsen timber motor yacht for private day trips, sunset cruises and romantic charters from Royal Phuket Marina";

const slideshow = [
  { 
    img: '/images/yacht/mami-wata/mami-wata-classic-motor-yacht-aerial-anchored.webp', 
    text: 'High aerial drone view of classic motor yacht Mami Wata anchored in deep blue Andaman waters with tender and paddleboard.' 
  },
  { 
    img: '/images/yacht/mami-wata/mami-wata-classic-yacht-aft-deck-seating.webp', 
    text: 'Aft deck view of classic motor yacht Mami Wata featuring wooden folding chairs and deck arrangement in a marina.' 
  },
  { 
    img: '/images/yacht/mami-wata/mami-wata-luxury-yacht-indoor-teak-saloon.webp', 
    text: 'Elegant indoor teak wood saloon and lounge seating area with floral arrangement on yacht Mami Wata.' 
