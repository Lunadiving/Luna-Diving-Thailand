---
import OptimizedImage from '../../components/OptimizedImage.astro';
// src/pages/thailand-yachts/index.astro

import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';

const fleet = [
  {
    slug: "song-of-songs",
    name: "Song of Songs",
    image: "/images/yacht/song-of-songs/song-of-songs-luxury-superyacht-stern-twilight.webp",
    altText: "Song of Songs 42m superyacht at twilight off Phuket, Thailand",
    tags: ["Superyacht", "6 Cabins", "Long Range"],
    specs: [
      { val: "12-Guest", desc: "Overnight, 20 for Day Trips" },
      { val: "42 Meters", desc: "Overall Length (LOA)" },
      { val: "10 Knots", desc: "Cruising Speed" }
    ],
    legal: "A 42-metre Heysea Asteria 142 motor yacht built for the long way between anchorages."
  },
  {
    slug: "aventure",
    name: "Aventure",
    image: "/images/yacht/aventure/aventure-sailing-yacht-under-full-sail.webp",
    altText: "Classic ketch Aventure under full sail in the Andaman Sea",
    tags: ["Classic Ketch", "Sailing Yacht", "Mergui Archipelago"],
    specs: [
      { val: "7-Guest", desc: "Overnight, 4 Cabins" },
      { val: "29 Meters", desc: "Overall Length (LOA)" },
      { val: "8 Knots", desc: "Cruising Speed" }
    ],
    legal: "A 29-metre classic ketch by Patrick Balta for the Andaman Sea and the Mergui Archipelago."
  },
  {
    slug: "maha-bhetra",
    name: "Maha Bhetra",
    image: "/images/yacht/maha-bhetra/maha-bhetra-luxury-yacht-phang-nga-bay-side-view.webp",
    altText: "Classic wooden motor yacht Maha Bhetra anchored in Phang Nga Bay",
    tags: ["Classic Motor Yacht", "Timber Hull", "Ed Tuttle Design"],
    specs: [
      { val: "6-Guest", desc: "Overnight, 12 for Day Trips" },
      { val: "27.4 Meters", desc: "Overall Length (LOA)" },
      { val: "8 Knots", desc: "Cruising Speed" }
    ],
    legal: "A 90ft classic motor yacht designed by Aman architect Ed Tuttle for unhurried Andaman voyages."
  },
  {
    slug: "seascape-2",
    name: "Seascape 2",
    image: "/images/yacht/seascape-2/seascape-2-motor-yacht-stern-profile.webp",
    altText: "Sunseeker flybridge motor yacht Seascape 2 in Phuket",
    tags: ["Sunseeker", "Flybridge", "Refitted 2022"],
    specs: [
      { val: "6-Guest", desc: "Overnight, 20 for Day Trips" },
      { val: "19.6 Meters", desc: "Overall Length (LOA)" },
      { val: "17 Knots", desc: "Cruising Speed" }
    ],
    legal: "A nineteen metre flybridge, refitted in 2022, berthed twenty minutes from open water."
  },
  {
    slug: "jawsss",
    name: "JAWSSS",
    image: "/images/yacht/jawsss/luxury-motor-yacht-jawsss-phuket.webp",
    altText: "Activa 5800 flybridge motor yacht JAWSSS in Phuket",
    tags: ["High Performance", "Sporty", "Speedy"],
    specs: [
      { val: "12-Guest", desc: "Day Trips, 6 Overnight" },
      { val: "18.6 Meters", desc: "Overall Length (LOA)" },
      { val: "12 Knots", desc: "Cruising Speed" }
    ],
    legal: "A flybridge cruiser built for the Andaman Sea, and for the way a day on it ought to unfold."
  },
  {
    slug: "galeon-500-fly",
    name: "Galeon 500 Fly",
    image: "/images/yacht/galeon-500-fly/galeon-500-luxury-yacht-cruising-open-water.webp",
    altText: "Luxury motor yacht cruising in the tropical waters of Thailand",
    tags: ["Private Charter", "Luxury", "Full Service"],
    specs: [
      { val: "10-Guest", desc: "Day Trips, 6 Overnight" },
      { val: "16.2 Meters", desc: "Overall Length (LOA)" },
      { val: "20 Knots", desc: "Cruising Speed" }
    ],
    legal: "Includes captain, crew, and fuel for standard routes. Perfect for private celebrations and island hopping."
  },
  {
    slug: "mami-wata",
    name: "Mami Wata",
    image: "/images/yacht/mami-wata/mami-wata-classic-motor-yacht-aerial-anchored.webp",
    altText: "Classic 1954 Halvorsen motor yacht Mami Wata at anchor, aerial view",
    tags: ["Classic 1954 Halvorsen", "Timber", "Refit 2023"],
    specs: [
      { val: "12-Guest", desc: "Day Trips, 6 Overnight" },
      { val: "15.3 Meters", desc: "Overall Length (LOA)" },
      { val: "8-12 Knots", desc: "Cruising Speed" }
    ],
    legal: "A 1954 Halvorsen, the Andaman coast, and nobody else aboard."
  },
  {
    slug: "nimbus-t11",
    name: "Nimbus T11",
    image: "/images/yacht/nimbus-t11/nimbus-t11-motor-yacht-cruising-andaman-sea.webp",
    altText: "Nimbus T11 motor yacht cruising in the Andaman Sea",
    tags: ["Day Boat", "Fast", "Modern Design"],
    specs: [
      { val: "10-Guest", desc: "Day Charter, Sleeps 4" },
      { val: "11.9 Meters", desc: "Overall Length (LOA)" },
      { val: "20-40 Knots", desc: "Speed Range" }
    ],
    legal: "A day boat built for the Andaman, and for the way a day at sea should actually feel."
  }
];
---

<Layout
  title="Thailand Yacht Charters | Private Cruises | Luna Diving"
  description="Private yacht charters from Phuket: superyachts, classic sailing and motor yachts, flybridge cruisers and fast day boats for the Andaman Sea, Phang Nga Bay and Mergui."
  image="/images/yacht/song-of-songs/song-of-songs-luxury-superyacht-stern-twilight.webp"
>
  
  <div class="block w-full pt-24 md:pt-28">
    
    <header class="max-w-5xl mx-auto pt-16 px-6 text-center font-sans">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1A1A1A] mb-12">
        Thailand Yacht Charter Fleet
      </h1>
    </header>

    <main class="max-w-5xl mx-auto px-6 pb-16 font-sans">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-12">
        {fleet.map((boat) => (
          <article class="group flex flex-col justify-between bg-white border border-gray-200 p-6 rounded-[24px] shadow-sm transition-all duration-300 hover:shadow-md">
            
            <div>
              <!-- LINK SULLA FOTO -->
              <a 
                href={`/thailand-yachts/${boat.slug}`} 
                class="block w-full aspect-video bg-[#f8f8fa] overflow-hidden rounded-xl mb-6"
                aria-label={`Explore ${boat.name} in detail`}
              >              
                <OptimizedImage 
                  src={boat.image} 
                  alt={boat.altText || boat.name} 
                  class="w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.02]"
                  loading="lazy"
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
              </a>

              <div class="space-y-3">
                <!-- LINK SUL NOME DELLA BARCA -->
                <h3 class="text-xl font-bold tracking-tight text-[#1A1A1A]">
                  <a 
                    href={`/thailand-yachts/${boat.slug}`} 
                    class="transition-colors hover:text-[#008EA7] group-hover:text-[#008EA7]"
                  >
                    {boat.name}
                  </a>
                </h3>
                
                <div class="flex flex-wrap gap-2">
                  {boat.tags.map((tag) => (
                    <span class="bg-[#008EA7]/10 text-[#008EA7] text-xs font-medium px-3 py-1 rounded-md border border-[#008EA7]/20">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <ul class="grid grid-cols-3 gap-4 my-6 py-4 border-t border-b border-gray-100" aria-label="Technical highlights">
                {boat.specs.map((spec) => (
                  <li class="space-y-1">
                    <div class="text-base font-semibold text-[#1A1A1A] tracking-tight leading-none">
                      {spec.val}
                    </div>
                    <div class="text-[11px] text-[#706F6F] font-normal leading-tight">
                      {spec.desc}
                    </div>
                  </li>
                ))}
              </ul>

              <div class="mb-6">
                <p class="text-[12px] text-[#706F6F] font-normal leading-relaxed">
                  {boat.legal}
                </p>
              </div>
            </div>

            <div class="mt-auto pt-2">
              <a 
                href={`/thailand-yachts/${boat.slug}`} 
                class="flex items-center justify-center bg-[#1A1A1A] text-white text-xs font-medium py-3 w-full rounded-full hover:bg-[#008EA7] transition-colors duration-300 text-center"
              >
                Explore in Detail
              </a>
            </div>

          </article>
        ))}
      </div>
    </main>

  </div>
</Layout>

<div class="fixed bottom-6 right-6 z-[99999] pointer-events-auto">
  <a 
    href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20a%20private%20yacht%20charter." 
    target="_blank" 
    rel="noopener noreferrer" 
    class="flex items-center justify-center w-14 h-14 md:w-[60px] md:h-[60px] bg-[#25D366] text-white rounded-full shadow-[0_4px_16px_rgba(0,0,0,0.25)] hover:scale-105 hover:bg-[#20ba5a] transition-all duration-300 ease-out"
    aria-label="Chat on WhatsApp"
  >
    <svg class="w-7 h-7 md:w-8 md:h-8" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
</div>