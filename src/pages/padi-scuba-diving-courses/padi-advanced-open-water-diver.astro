---
// src/pages/padi-scuba-diving-courses/padi-advanced-open-water-diver.astro
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';

// Immagine provvisoria (illustrazione): sostituire con una foto reale quando disponibile
const heroImage = '/images/courses/padi-advanced-open-water-diver-phuket.webp';

const programSpecs = [
  { title: "Duration", value: "2 Days Minimum" },
  { title: "Max Depth", value: "30 Meters / 98 Feet" },
  { title: "Prerequisites", value: "12+ Years Old", sub: "Open Water Diver or equivalent" },
  { title: "Price", value: "13,900 THB", sub: "Private instructor" }
];

const inclusions = [
  "PADI Advanced Open Water Diver book and learning materials",
  "Professional and experienced private instructor for 2 days",
  "PADI worldwide certification fees",
  "6 boat dives during the course",
  "Full meals on board: breakfast, lunch, snacks, and fresh fruits",
  "Complimentary water, tea, and coffee on the boat",
  "Full boat insurance"
];

const faqs = [
  {
    q: 'What is the PADI Advanced Open Water Diver course?',
    a: 'It is the next step after the Open Water Diver course. Through 5 adventure dives, including deep diving and underwater navigation, you gain experience and confidence and are certified to dive to 30 metres (98 feet).'
  },
  {
    q: 'How long does the Advanced Open Water course take?',
    a: 'A minimum of 2 days with a private instructor, with 6 boat dives during the course. The theory is reviewed with your instructor, and there is no long classroom exam: most of the learning happens in the water.'
  },
  {
    q: 'How much does the Advanced Open Water course cost in Phuket?',
    a: 'The course costs 13,900 THB. It includes your private instructor for 2 days, the PADI book and learning materials, the certification fee, 6 boat dives, meals, snacks, fruit, water, tea and coffee on board and boat insurance. Equipment rental is 600 THB per set per day if you need it.'
  },
  {
    q: 'What are the requirements?',
    a: 'You must be at least 12 years old and hold a PADI Open Water Diver certification or an equivalent from another training agency. If you are not certified yet, start with our 3-day PADI Open Water Diver course.'
  },
  {
    q: 'Do I need Advanced Open Water for the Similan Islands?',
    a: 'It is not required for every site, but it is strongly recommended. Many of the best Similan dive sites, such as Koh Bon and Richelieu Rock, are deeper than 18 metres, and the Advanced certification lets you dive them to 30 metres with more confidence.'
  },
  {
    q: 'Which adventure dives can I choose?',
    a: 'The deep dive and the underwater navigation dive are part of every course. You then choose three more adventure dives together with your instructor, based on your interests and the dive sites, such as peak performance buoyancy or fish identification.'
  }
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'PADI Advanced Open Water Diver Course in Phuket',
    description: 'Private 2-day PADI Advanced Open Water Diver course in Phuket: 5 adventure dives including deep and navigation, 6 boat dives, certification to 30 metres. Age 12+.',
    url: 'https://luna-diving-thailand.com/padi-scuba-diving-courses/padi-advanced-open-water-diver/',
    provider: {
      '@type': 'Organization',
      name: 'Luna Diving Thailand',
      sameAs: 'https://luna-diving-thailand.com/'
    },
    offers: {
      '@type': 'Offer',
      price: '13900',
      priceCurrency: 'THB',
      category: 'Paid',
      url: 'https://luna-diving-thailand.com/padi-scuba-diving-courses/padi-advanced-open-water-diver/'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a }
    }))
  }
];

const whatsappBook = `https://wa.me/66918233120?text=${encodeURIComponent("Hi Luna Diving! I'm interested in booking the PADI Advanced Open Water Diver course (13,900 THB).")}`;
const whatsappInfo = `https://wa.me/66918233120?text=${encodeURIComponent("Hi Luna Diving! I'm interested in the PADI Advanced Open Water Diver course.")}`;
---

<Layout
  title="PADI Advanced Open Water Course Phuket | Private | 13,900 THB"
  description="Private PADI Advanced Open Water Diver course in Phuket: 2 days, 5 adventure dives incl. deep and navigation, 6 boat dives, dive to 30 m. Age 12+, 13,900 THB."
  image={heroImage}
>
  
  <div class="block w-full pt-24 md:pt-32 font-sans bg-[#fbfbfc]">
  
    <Breadcrumb />
    
    <!-- Hero Section -->
    <header class="max-w-4xl mx-auto pt-12 pb-8 px-6 text-center">
      <span class="text-xs font-bold tracking-[0.25em] text-[#008EA7] uppercase block mb-3">
        Advanced Certification Course
      </span>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-[#1A1A1A] mb-6 leading-tight">
        PADI Advanced Open Water <br class="hidden md:inline"/>Diver Course in Phuket
      </h1>
      <p class="text-base md:text-lg text-[#50555c] leading-relaxed max-w-2xl mx-auto">
        Take your diving to the next level with a <strong>private PADI instructor</strong>. In <strong>2 days</strong> you complete
        <strong>5 adventure dives</strong>, including deep diving and underwater navigation, and get certified to dive to
        <strong>30 metres</strong>, ready for the Similan Islands and Richelieu Rock.
      </p>
    </header>

    <!-- Hero Image (illustrazione provvisoria) -->
    <section class="max-w-5xl mx-auto px-6 mb-12">
      <OptimizedImage
        src={heroImage}
        alt="Illustration of an advanced scuba diver descending in deep blue water next to a manta ray"
        class="w-full h-auto rounded-[24px] shadow-sm"
        loading="eager"
        fetchpriority="high"
        widths={[480, 800, 1200]}
        sizes="(max-width: 1024px) 100vw, 976px"
      />
    </section>

    <!-- Quick Specs Grid -->
    <section class="max-w-5xl mx-auto px-6 mb-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {programSpecs.map((spec) => (
          <div class="bg-white border border-gray-100 p-6 rounded-[20px] shadow-sm text-center flex flex-col items-center justify-center">
            <h3 class="text-xs font-bold text-[#706F6F] uppercase tracking-wider mb-1">{spec.title}</h3>
            <p class="text-lg font-bold text-[#1A1A1A]">{spec.value}</p>
            {spec.sub && <p class="text-xs text-[#706F6F] font-normal mt-0.5">{spec.sub}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- Main Content & Details -->
    <section class="max-w-5xl mx-auto px-6 pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Column: Details & Course Structure -->
        <div class="lg:col-span-7 space-y-10">
          
          <!-- Course Overview -->
          <div class="bg-white border border-gray-200 p-8 rounded-[24px] shadow-sm">
            <h2 class="text-xl font-bold text-[#1A1A1A] mb-4">Build Experience and Dive Deeper</h2>
            <p class="text-[15px] text-[#40444b] leading-relaxed mb-4">
              The Advanced Open Water Diver course is made for certified Open Water divers who want more confidence and
              more experience. Instead of long classroom sessions, you learn mostly in the water, trying different types
              of diving with your private instructor, who adapts every dive to your level and interests.
            </p>
            <p class="text-[15px] text-[#40444b] leading-relaxed mb-6">
              At the end of the course you are certified to dive to 30 metres (98 feet), which opens up deeper reefs,
              pinnacles and wrecks in Thailand and around the world.
            </p>
            
            <h3 class="text-sm font-bold text-[#1A1A1A] uppercase tracking-wide mb-3">Your 5 Adventure Dives:</h3>
            <ul class="space-y-3 text-[15px] text-[#40444b]">
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-[#008EA7] mt-2 shrink-0"></span>
                <span><strong>Deep Diving:</strong> Explore down below 18 meters/60 feet and manage physiological effects.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-[#008EA7] mt-2 shrink-0"></span>
                <span><strong>Underwater Navigation:</strong> Learn compass navigation and how to find your way using natural references.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-[#008EA7] mt-2 shrink-0"></span>
                <span><strong>3 Adventure Dives of Your Choice:</strong> Chosen with your instructor based on your interests and the dive sites.</span>
              </li>
            </ul>
          </div>

          <!-- Course Structure Phases -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-[#1A1A1A] px-2">Course Structure</h2>
            
            <!-- Phase 1 -->
            <div class="bg-white border border-gray-200 p-6 rounded-[20px] shadow-sm flex gap-4">
              <div class="bg-[#008EA7]/10 text-[#008EA7] w-10 h-10 rounded-xl flex items-center justify-center font-bold text-sm shrink-0">
                1
              </div>
              <div>
                <h3 class="font-bold text-base text-[#1A1A1A] mb-1">Phase 1 – Knowledge Development</h3>
                <p class="text-sm text-[#706F6F] leading-relaxed">
                  Review the theoretical advanced principles behind specialized environments, deep physics, and navigation logistics.
                </p>
              </div>
            </div>

            <!-- Phase 2 -->
            <div class="bg-white border border-gray-200 p-6 rounded-[20px] shadow-sm flex gap-4">
              <div class="bg-[#008EA7]/10 text-[#008EA7] w-10 h-10 rounded-xl flex items-center justify-center font-bold text-sm shrink-0">
                2
              </div>
              <div>
                <h3 class="font-bold text-base text-[#1A1A1A] mb-1">Phase 2 – Advanced Water Dives</h3>
                <p class="text-sm text-[#706F6F] leading-relaxed">
                  Complete 6 real-world ocean boat dives to put your knowledge directly to work, refine buoyancy control, and unlock maximum depths.
                </p>
              </div>
            </div>
          </div>

          <!-- SEO content -->
          <div class="bg-white border border-gray-200 p-8 rounded-[24px] shadow-sm space-y-4">
            <h2 class="text-xl font-bold text-[#1A1A1A]">Why Take Advanced Open Water in Phuket?</h2>
            <p class="text-[15px] text-[#40444b] leading-relaxed">
              Many of Thailand's most famous dive sites, such as Koh Bon and Richelieu Rock in the Similan and Surin
              National Parks, go deeper than 18 metres. Completing your Advanced Open Water course in Phuket before a
              liveaboard means you can enjoy these sites to 30 metres, with better buoyancy and more confidence.
            </p>
            <h2 class="text-xl font-bold text-[#1A1A1A] pt-2">After Your Advanced Course</h2>
            <p class="text-[15px] text-[#40444b] leading-relaxed">
              Put your new skills to use on a <a href="/thailand-liveaboards/" class="text-[#008EA7] font-semibold underline underline-offset-2">Similan Islands liveaboard</a>
              or on our <a href="/day-trip-phuket/" class="text-[#008EA7] font-semibold underline underline-offset-2">diving day trips from Phuket</a>.
              Want to become a safer, more confident buddy? The next step is the
              <a href="/padi-scuba-diving-courses/padi-rescue-diver/" class="text-[#008EA7] font-semibold underline underline-offset-2">PADI Rescue Diver course</a>.
              Not certified yet? Start with the
              <a href="/padi-scuba-diving-courses/padi-open-water-diver/" class="text-[#008EA7] font-semibold underline underline-offset-2">PADI Open Water Diver course</a>,
              or compare all our <a href="/padi-scuba-diving-courses/" class="text-[#008EA7] font-semibold underline underline-offset-2">PADI courses in Phuket</a>.
            </p>
          </div>

          <!-- FAQ -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-[#1A1A1A] px-2">PADI Advanced Open Water FAQ</h2>
            <div class="bg-white border border-gray-200 rounded-[20px] shadow-sm divide-y divide-gray-100">
              {faqs.map((item) => (
                <details class="group px-6 py-4">
                  <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-semibold text-[15px] text-[#1A1A1A] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#008EA7] focus-visible:outline-offset-4">
                    {item.q}
                    <span class="text-[#008EA7] text-xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                  </summary>
                  <p class="mt-3 text-sm text-[#40444b] leading-relaxed">{item.a}</p>
                </details>
              ))}
            </div>
          </div>

        </div>

        <!-- Right Column: Pricing & Booking Card -->
        <div class="lg:col-span-5 lg:sticky lg:top-32">
          <div class="bg-[#1A1A1A] text-white p-8 rounded-[28px] shadow-lg relative overflow-hidden">
            
            <div class="absolute -right-12 -top-12 w-32 h-32 bg-[#008EA7]/20 rounded-full blur-xl"></div>
            
            <span class="text-[11px] font-bold tracking-widest text-[#008EA7] uppercase block mb-1">Private Instructor Package</span>
            <h3 class="text-2xl font-bold mb-4">Book Your Course</h3>
            
            <div class="flex items-baseline gap-2 mb-6 border-b border-white/10 pb-6">
              <span class="text-xs text-gray-400 font-normal">All-Inclusive Price</span>
              <span class="text-4xl font-extrabold text-[#008EA7]">13,900 THB</span>
            </div>

            <!-- What's Included -->
            <div class="space-y-4 mb-6">
              <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400">What's Included:</h4>
              <ul class="space-y-3 text-sm text-gray-200">
                {inclusions.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#008EA7] mt-2 shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- What's Not Included -->
            <div class="space-y-3 mb-8 border-t border-white/10 pt-4">
              <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400">Not Included:</h4>
              <p class="text-xs text-gray-300 leading-relaxed mb-2">
                Transfers from/to your hotel or villa, and anything not explicitly mentioned in the inclusions.
              </p>
              <p class="text-xs text-gray-300 bg-white/5 p-3 rounded-lg border border-white/10 font-medium">
                Scuba equipment rental: available if needed at 600 THB per set/day.
              </p>
            </div>

            <!-- CTA Buttons -->
            <div class="space-y-3">
              <a 
                href={whatsappBook}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center bg-[#25D366] hover:bg-[#20ba5a] text-white text-sm font-bold py-3.5 w-full rounded-full transition-all duration-300 text-center shadow-md"
              >
                Book via WhatsApp
              </a>
              <a 
                href="/contact/?vessel=PADI%20Advanced%20Open%20Water%20Diver" 
                class="flex items-center justify-center bg-white/10 hover:bg-white/20 text-white text-sm font-medium py-3.5 w-full rounded-full transition-all duration-300 text-center"
              >
                Inquire via Email
              </a>
            </div>

          </div>
        </div>

      </div>
    </section>

  </div>

  {structuredData.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))}

  <!-- Floating WhatsApp Button -->
  <div class="fixed bottom-6 right-6 z-[99999] pointer-events-auto">
    <a
      href={whatsappInfo}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center w-14 h-14 md:w-[60px] md:h-[60px] bg-[#25D366] text-white rounded-full shadow-[0_4px_16px_rgba(0,0,0,0.25)] hover:scale-105 hover:bg-[#20ba5a] transition-all duration-300 ease-out"
      aria-label="Chat on WhatsApp"
    >
      <svg class="w-7 h-7 md:w-8 md:h-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </div>
</Layout>
