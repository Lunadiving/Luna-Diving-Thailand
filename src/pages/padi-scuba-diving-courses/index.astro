---
// src/pages/padi-scuba-diving-courses/index.astro
import Layout from '../../layouts/Layout.astro';

// Dati allineati alle pagine dei singoli corsi
const courses = [
  {
    title: 'PADI Discover Scuba Diving',
    slug: 'padi-discover-scuba-diving',
    level: 'Try Diving · No Experience',
    duration: '1 Day',
    price: 'THB 4,900',
    facts: ['Age 10+', 'Max 12 m', '2 boat dives'],
    description: 'Try scuba diving for the first time with a private PADI instructor. After a short briefing you make two easy boat dives at the Racha Islands, with no certification needed.',
    features: ['Private PADI instructor', 'Full set of diving gear', '2 introductory boat dives at Racha Yai & Racha Noi', 'Boat insurance']
  },
  {
    title: 'PADI Open Water Diver',
    slug: 'padi-open-water-diver',
    level: 'Beginner · First Certification',
    duration: '3 Days',
    price: 'THB 16,900',
    facts: ['Age 10+', 'Max 18 m', '6 boat dives'],
    description: 'The world\'s most popular scuba course. Learn the theory and skills, then complete your open water dives from the boat and earn a certification recognised all over the world.',
    features: ['Private instructor for 3 days', 'PADI book, materials and certification fee', 'All rental equipment and logbook', '6 open water boat dives']
  },
  {
    title: 'PADI Advanced Open Water Diver',
    slug: 'padi-advanced-open-water-diver',
    level: 'Next Step · Certified Divers',
    duration: '2 Days',
    price: 'THB 13,900',
    facts: ['Age 12+', 'Max 30 m', '6 boat dives'],
    description: 'Build confidence and experience with adventure dives such as deep and navigation. Certified to 30 metres, you can dive the deeper sites of the Similans and Richelieu Rock.',
    features: ['Private instructor for 2 days', 'PADI book, materials and certification fee', '6 boat dives', 'Meals, snacks and drinks on board']
  },
  {
    title: 'PADI Rescue Diver',
    slug: 'padi-rescue-diver',
    level: 'Safety · Experienced Divers',
    duration: '3 Days',
    price: 'THB 16,900',
    facts: ['Age 12+', 'Max 18 m', '6 boat dives'],
    description: 'Learn to prevent and manage problems underwater and at the surface. A challenging and rewarding course that makes you a safer, more confident dive buddy.',
    features: ['Private instructor for 3 days', 'PADI book, materials and certification fee', '6 open water boat dives', 'Requires Adventure Diver and EFR within 24 months']
  }
];

const faqs = [
  {
    q: 'How much does a PADI Open Water course cost in Phuket?',
    a: 'The PADI Open Water Diver course with Luna Diving costs THB 16,900. It includes a private instructor for 3 days, the PADI book and learning materials, the certification fee, all rental equipment, a logbook and 6 open water boat dives.'
  },
  {
    q: 'Can I try scuba diving without a certification?',
    a: 'Yes. The PADI Discover Scuba Diving experience costs THB 4,900 and is open to anyone aged 10 or older who can swim. You make two boat dives to a maximum of 12 metres at the Racha Islands with a private PADI instructor.'
  },
  {
    q: 'How long does it take to get scuba certified?',
    a: 'The PADI Open Water Diver course takes a minimum of 3 days. You can then continue with the PADI Advanced Open Water Diver course in 2 days and the PADI Rescue Diver course in 3 days.'
  },
  {
    q: 'What is the minimum age for PADI courses?',
    a: 'Children can join PADI Discover Scuba Diving and PADI Open Water Diver from 10 years old. The Advanced Open Water Diver and Rescue Diver courses are available from 12 years old.'
  },
  {
    q: 'Do I need Advanced Open Water to dive the Similan Islands?',
    a: 'No, an Open Water certification is enough for many Similan dive sites. The Advanced Open Water course certifies you to 30 metres and is recommended for deeper sites such as Koh Bon and Richelieu Rock, so many divers take it in Phuket before joining a liveaboard.'
  },
  {
    q: 'Are the courses private?',
    a: 'Yes. Our Open Water, Advanced Open Water and Rescue Diver courses include a private instructor for the whole course, and Discover Scuba Diving is also led by a private PADI instructor, so the pace is set around you.'
  }
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'PADI scuba diving courses in Phuket',
    itemListElement: courses.map((course, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Course',
        name: course.title,
        description: course.description,
        url: `https://luna-diving-thailand.com/padi-scuba-diving-courses/${course.slug}/`,
        provider: {
          '@type': 'Organization',
          name: 'Luna Diving Thailand',
          sameAs: 'https://luna-diving-thailand.com/'
        }
      }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a }
    }))
  }
];

const whatsappUrl = `https://wa.me/66918233120?text=${encodeURIComponent("Hi Luna Diving! I'd like information about your PADI scuba diving courses in Phuket.")}`;
---

<Layout
  title="PADI Diving Courses Phuket | Private Instructor | Luna Diving"
  description="PADI scuba diving courses in Phuket with a private instructor: Discover Scuba from THB 4,900, Open Water Diver THB 16,900, Advanced Open Water and Rescue Diver."
>
  <main class="courses-page">

    <section class="hero-section">
      <div class="container">
        <span class="subtitle">PADI Education in Phuket</span>
        <h1>PADI Scuba Diving Courses in Phuket</h1>
        <p class="hero-text">
          Learn to dive or take the next step with a <strong>private PADI instructor</strong>. From a first try with Discover Scuba Diving
          to your Open Water, Advanced Open Water and Rescue Diver certifications, every course runs at your pace,
          with boat dives in the warm, clear water of the Andaman Sea.
        </p>
      </div>
    </section>

    <section class="courses-section" aria-labelledby="courses-title">
      <div class="container">
        <h2 id="courses-title" class="sr-only">Our PADI courses</h2>
        <div class="courses-grid">
          {courses.map((course) => (
            <article class="course-card">
              <div class="card-header">
                <span class="course-level">{course.level}</span>
                <h3 class="course-title">
                  <a href={`/padi-scuba-diving-courses/${course.slug}/`}>{course.title}</a>
                </h3>
                <div class="course-meta">
                  <span class="meta-item">{course.duration}</span>
                  <span class="meta-item price">{course.price}</span>
                </div>
                <ul class="course-facts" aria-label={`${course.title} key facts`}>
                  {course.facts.map((fact) => <li>{fact}</li>)}
                </ul>
              </div>

              <div class="card-body">
                <p class="course-desc">{course.description}</p>
                <ul class="features-list">
                  {course.features.map((feature) => <li>{feature}</li>)}
                </ul>
              </div>

              <div class="card-footer">
                <a href={`/padi-scuba-diving-courses/${course.slug}/`} class="btn-primary" aria-label={`View ${course.title} details`}>
                  View Course Details
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="content-section" aria-labelledby="path-title">
      <div class="container narrow">
        <h2 id="path-title">Your PADI Path: From First Dive to Rescue Diver</h2>
        <p>
          PADI is the world's largest scuba diving training organisation, and a PADI certification is recognised by dive centres
          everywhere. Most divers follow the same path. If you have never dived before, <a href="/padi-scuba-diving-courses/padi-discover-scuba-diving/">Discover Scuba Diving</a>
          lets you try in a single day. The <a href="/padi-scuba-diving-courses/padi-open-water-diver/">Open Water Diver course</a> is your
          first full certification, allowing you to dive to 18 metres with a buddy anywhere in the world.
        </p>
        <p>
          With the <a href="/padi-scuba-diving-courses/padi-advanced-open-water-diver/">Advanced Open Water Diver course</a> you gain
          experience with deep and navigation dives and can dive to 30 metres, ideal before a liveaboard to the Similan Islands.
          The <a href="/padi-scuba-diving-courses/padi-rescue-diver/">Rescue Diver course</a> then teaches you to prevent and handle
          problems, and is the step many divers take before going professional.
        </p>

        <h2>Why Learn to Dive in Phuket</h2>
        <p>
          Phuket has warm water all year, a wide choice of dive sites within a short boat ride and some of the best diving in
          Southeast Asia on its doorstep. Training dives take place from the boat at sites such as the Racha Islands, so even
          your first dives are real ocean dives with coral reefs and tropical fish, not just a swimming pool.
        </p>
        <p>
          With a private instructor, you never wait for a group: the lessons follow your rhythm, there is time for extra
          practice, and the instructor's attention stays on you. It is the most comfortable way to learn, especially for
          nervous beginners, couples and families.
        </p>

        <h2>From Your Course to the Similan Islands</h2>
        <p>
          Once certified, the Andaman Sea is yours to explore. Join our <a href="/day-trip-phuket/">diving day trips from Phuket</a>
          to Phi Phi and the Racha Islands, or step up to a <a href="/thailand-liveaboards/">Similan Islands liveaboard</a>
          with dives at Koh Bon, Koh Tachai and Richelieu Rock. You can complete your Advanced Open Water course in Phuket
          and join a liveaboard in the same holiday.
        </p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="faq-title">
      <div class="container narrow">
        <h2 id="faq-title">PADI Courses in Phuket: FAQ</h2>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">{item.q}</summary>
              <p class="faq-answer">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <h2>Ready to Start Diving?</h2>
          <p>Tell us which course you are interested in and your dates, and we will check instructor availability and answer all your questions.</p>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">Contact us on WhatsApp</a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .courses-page {
    padding-top: clamp(120px, 10vw, 160px);
    background-color: #fbfbfc;
    color: #010205;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero-section {
    text-align: center;
    padding-bottom: 60px;
  }

  .subtitle {
    font-size: 11px;
    letter-spacing: 4px;
    color: #008EA7;
    text-transform: uppercase;
    font-weight: 700;
    display: block;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.5px;
    margin: 0 0 20px 0;
    line-height: 1.15;
  }

  .hero-text {
    max-width: 700px;
    margin: 0 auto;
    font-size: 16px;
    line-height: 1.6;
    color: #50555c;
  }

  .courses-section {
    padding: 40px 0 80px 0;
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 32px;
  }

  .course-card {
    background: #ffffff;
    border: 1px solid #eef0f3;
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .course-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(1, 2, 5, 0.04);
  }

  .course-level {
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    color: #71777f;
    letter-spacing: 1px;
  }

  .course-title {
    font-size: 22px;
    margin: 8px 0 16px 0;
    font-weight: 700;
  }

  .course-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    border-bottom: 1px dashed #eef0f3;
    margin-bottom: 20px;
    font-size: 14px;
    font-weight: 600;
  }

  .price {
    color: #008EA7;
    font-size: 16px;
  }

  .course-desc {
    font-size: 15px;
    line-height: 1.6;
    color: #40444b;
    margin-bottom: 24px;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
    color: #50555c;
  }

  .btn-primary {
    display: block;
    text-align: center;
    background-color: #010205;
    color: #ffffff;
    text-decoration: none;
    padding: 14px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #008EA7;
  }

  .cta-section {
    padding-bottom: 80px;
  }

  .cta-box {
    background-color: #010205;
    color: #ffffff;
    padding: 60px 40px;
    border-radius: 16px;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .cta-box h2 {
    font-size: 28px;
    margin-top: 0;
  }

  .cta-box p {
    color: #a0a5ad;
    max-width: 500px;
    margin: 16px auto 32px auto;
    line-height: 1.6;
  }

  .btn-secondary {
    display: inline-block;
    background-color: #ffffff;
    color: #010205;
    text-decoration: none;
    padding: 14px 32px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    transition: background-color 0.2s ease;
  }

  .btn-secondary:hover {
    background-color: #008EA7;
    color: #ffffff;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .course-title a {
    color: inherit;
    text-decoration: none;
  }

  .course-title a:hover,
  .course-title a:focus-visible {
    color: #008EA7;
  }

  .course-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
  }

  .course-facts li {
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(0, 142, 167, 0.08);
    color: #008EA7;
    font-size: 12px;
    font-weight: 600;
  }

  .features-list li {
    position: relative;
    padding-left: 22px;
  }

  .features-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #008EA7;
    font-weight: 700;
  }

  .content-section {
    padding-bottom: 72px;
  }

  .container.narrow {
    max-width: 800px;
  }

  .content-section h2 {
    margin: 40px 0 16px;
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1.25;
  }

  .content-section h2:first-child {
    margin-top: 0;
  }

  .content-section p {
    margin: 0 0 16px;
    color: #40444b;
    font-size: 16px;
    line-height: 1.75;
  }

  .content-section a {
    color: #008EA7;
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .faq-list {
    border-top: 1px solid #e6e8eb;
  }

  .faq-item {
    padding: 16px 0;
    border-bottom: 1px solid #e6e8eb;
  }

  .faq-question {
    cursor: pointer;
    font-weight: 700;
    line-height: 1.5;
  }

  .faq-answer {
    margin: 12px 0 0 !important;
  }

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible,
  .faq-question:focus-visible,
  .content-section a:focus-visible {
    outline: 2px solid #008EA7;
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .courses-grid {
      grid-template-columns: 1fr;
    }
    .cta-box {
      padding: 40px 20px;
    }
  }
</style>